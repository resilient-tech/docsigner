{
  "manifest_version": 3,
  "name": "DocSigner",
  "version": "0.2.0",
  "description": "Lets web pages sign document hashes with certificates on USB tokens and smartcards, through a local native host.",
  "permissions": ["nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "docsigner@docsigner.org",
      "strict_min_version": "121.0"
    }
  }
}
