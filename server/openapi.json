{
  "components": {
    "schemas": {
      "AuditRecord": {
        "description": "What got signed, by whom, when. For the caller's audit trail.",
        "properties": {
          "certificate_issuer": {
            "title": "Certificate Issuer",
            "type": "string"
          },
          "certificate_serial": {
            "title": "Certificate Serial",
            "type": "string"
          },
          "completed_at": {
            "title": "Completed At",
            "type": "string"
          },
          "digest_algorithm": {
            "title": "Digest Algorithm",
            "type": "string"
          },
          "document_sha256": {
            "title": "Document Sha256",
            "type": "string"
          },
          "field_name": {
            "title": "Field Name",
            "type": "string"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "signer": {
            "title": "Signer",
            "type": "string"
          }
        },
        "required": [
          "signer",
          "certificate_serial",
          "certificate_issuer",
          "profile",
          "digest_algorithm",
          "field_name",
          "document_sha256",
          "completed_at"
        ],
        "title": "AuditRecord",
        "type": "object"
      },
      "BatchCompleteItem": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "signature": {
            "title": "Signature",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "signature"
        ],
        "title": "BatchCompleteItem",
        "type": "object"
      },
      "BatchCompleteRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BatchCompleteItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "BatchCompleteRequest",
        "type": "object"
      },
      "BatchCompleted": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/SignatureCompleted"
            },
            "title": "Documents",
            "type": "array"
          }
        },
        "required": [
          "documents"
        ],
        "title": "BatchCompleted",
        "type": "object"
      },
      "BatchSession": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "to_sign_hash": {
            "title": "To Sign Hash",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "to_sign_hash"
        ],
        "title": "BatchSession",
        "type": "object"
      },
      "BatchStarted": {
        "properties": {
          "digest_algorithm": {
            "enum": [
              "sha256",
              "sha384",
              "sha512"
            ],
            "title": "Digest Algorithm",
            "type": "string"
          },
          "expires_at": {
            "title": "Expires At",
            "type": "string"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/BatchSession"
            },
            "title": "Sessions",
            "type": "array"
          }
        },
        "required": [
          "sessions",
          "digest_algorithm",
          "expires_at"
        ],
        "title": "BatchStarted",
        "type": "object"
      },
      "CompleteRequest": {
        "properties": {
          "signature": {
            "description": "The signature over `to_sign_hash`, base64. PKCS#1 v1.5 for RSA, a DER ECDSA-Sig-Value for EC.",
            "title": "Signature",
            "type": "string"
          }
        },
        "required": [
          "signature"
        ],
        "title": "CompleteRequest",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "enum": [
              "DOCUMENT_INVALID",
              "CERT_INVALID",
              "SESSION_NOT_FOUND",
              "SESSION_EXPIRED",
              "SIGNATURE_INVALID",
              "PROFILE_UNSUPPORTED",
              "INTERNAL"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PdfaClaim": {
        "description": "What the file claimed about being PDF/A, if it claimed anything.",
        "properties": {
          "conformance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conformance"
          },
          "part": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Part"
          }
        },
        "title": "PdfaClaim",
        "type": "object"
      },
      "ServerSideSigned": {
        "properties": {
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "download_url": {
            "examples": [
              "/api/documents/abc123"
            ],
            "title": "Download Url",
            "type": "string"
          },
          "pdfa": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PdfaClaim"
              },
              {
                "type": "null"
              }
            ]
          },
          "pdfa_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdfa Note"
          }
        },
        "required": [
          "document_id",
          "download_url"
        ],
        "title": "ServerSideSigned",
        "type": "object"
      },
      "SessionStarted": {
        "properties": {
          "digest_algorithm": {
            "enum": [
              "sha256",
              "sha384",
              "sha512"
            ],
            "title": "Digest Algorithm",
            "type": "string"
          },
          "expires_at": {
            "description": "RFC 3339, UTC.",
            "examples": [
              "2026-08-11T12:00:00Z"
            ],
            "title": "Expires At",
            "type": "string"
          },
          "pdfa": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PdfaClaim"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present only when the input claims PDF/A."
          },
          "pdfa_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present only when a visible appearance would break that claim.",
            "title": "Pdfa Note"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "to_sign_hash": {
            "description": "The hash to sign, base64.",
            "title": "To Sign Hash",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "to_sign_hash",
          "digest_algorithm",
          "expires_at"
        ],
        "title": "SessionStarted",
        "type": "object"
      },
      "SignServerSideRequest": {
        "properties": {
          "document": {
            "description": "The document, base64.",
            "title": "Document",
            "type": "string"
          },
          "options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SigningOptions"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "document"
        ],
        "title": "SignServerSideRequest",
        "type": "object"
      },
      "SignatureCompleted": {
        "properties": {
          "audit": {
            "$ref": "#/components/schemas/AuditRecord"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "download_url": {
            "examples": [
              "/api/documents/abc123"
            ],
            "title": "Download Url",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "download_url",
          "audit"
        ],
        "title": "SignatureCompleted",
        "type": "object"
      },
      "SigningOptions": {
        "additionalProperties": true,
        "description": "Signing options. Unknown fields pass straight through, on purpose.\n\nA newer client talking to an older server should hear \"I don't support that\nprofile\", not \"your request is malformed\".",
        "properties": {
          "appearance": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Visible signature appearance. Omit to sign invisibly, which is what keeps a PDF/A document conformant.",
            "title": "Appearance"
          },
          "field_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Signature field name; generated when omitted.",
            "title": "Field Name"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Signature location.",
            "title": "Location"
          },
          "policy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Signature policy identifier to embed.",
            "title": "Policy"
          },
          "profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "PAdES/CAdES baseline profile: B-B, B-T, B-LT, B-LTA, CCA-LTV, CCA-LTA.",
            "examples": [
              "B-T"
            ],
            "title": "Profile"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Signature reason.",
            "title": "Reason"
          },
          "tsa": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timestamp authority by registry name; the server default when omitted.",
            "examples": [
              "digicert"
            ],
            "title": "Tsa"
          }
        },
        "title": "SigningOptions",
        "type": "object"
      },
      "StartBatchRequest": {
        "properties": {
          "certificate": {
            "description": "One certificate for the whole batch, base64 DER.",
            "title": "Certificate",
            "type": "string"
          },
          "documents": {
            "description": "Up to 50 PDFs, each base64.",
            "items": {
              "type": "string"
            },
            "title": "Documents",
            "type": "array"
          },
          "options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SigningOptions"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "documents",
          "certificate"
        ],
        "title": "StartBatchRequest",
        "type": "object"
      },
      "StartSignatureRequest": {
        "properties": {
          "certificate": {
            "description": "The signer's certificate, base64 DER.",
            "title": "Certificate",
            "type": "string"
          },
          "document": {
            "description": "The PDF, base64.",
            "title": "Document",
            "type": "string"
          },
          "options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SigningOptions"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "document",
          "certificate"
        ],
        "title": "StartSignatureRequest",
        "type": "object"
      },
      "StoredDocument": {
        "properties": {
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "download_url": {
            "examples": [
              "/api/documents/abc123"
            ],
            "title": "Download Url",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "download_url"
        ],
        "title": "StoredDocument",
        "type": "object"
      },
      "ValidateRequest": {
        "properties": {
          "document": {
            "description": "The signed PDF to check, base64.",
            "title": "Document",
            "type": "string"
          }
        },
        "required": [
          "document"
        ],
        "title": "ValidateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationResult": {
        "properties": {
          "pdfa": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PdfaClaim"
              },
              {
                "type": "null"
              }
            ]
          },
          "signatures": {
            "description": "One entry per signature: validity, intactness, trust and the signer.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Signatures",
            "type": "array"
          }
        },
        "required": [
          "signatures"
        ],
        "title": "ValidationResult",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The document never leaves this server. A browser carries a 32-byte hash out and a signature back, so a 200 MB file signs as fast as a 200 KB one.\n\nThe protocol is frozen in CONTRACTS.md section 1. Generate a client from this document rather than hand-writing one.",
    "summary": "Sign PDFs, any file (CAdES) and XML (XAdES) with a token or a server-held key.",
    "title": "signer-server",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/cades/sign-server-side": {
      "post": {
        "operationId": "cades_server_side_api_cades_sign_server_side_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignServerSideRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredDocument"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad document, certificate or signature"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such session or document"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session or document expired"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Produce a .p7s with the server's own key",
        "tags": [
          "CAdES"
        ]
      }
    },
