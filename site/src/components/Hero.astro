---
import Button from './Button.astro';

interface Props {
  title: string;
  lede: string;
  /* Small line above the headline. A fact, never a slogan. */
  kicker?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
  centre?: boolean;
}

const { title, lede, kicker, primary, secondary, centre } = Astro.props;
---

<section class={centre ? 'hero centre' : 'hero'}>
  <div class="wrap inner">
    {kicker && <p class="label">{kicker}</p>}
    <h1>{title}</h1>
    <p class="lede">{lede}</p>

    {
      (primary || secondary) && (
        <div class="actions">
          {primary && (
            <Button href={primary.href} variant="primary" size="lg">
              {primary.label}
            </Button>
          )}
          {secondary && (
            <Button href={secondary.href} variant="default" size="lg">
              {secondary.label}
            </Button>
          )}
        </div>
      )
    }

    <slot />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--s-24) var(--s-16);
    border-bottom: var(--hairline);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .centre .inner {
    align-items: center;
    text-align: center;
  }

  .centre h1 {
    max-width: 28ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--s-16) var(--s-12);
    }
  }
</style>
