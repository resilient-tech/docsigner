---
import { Icon } from 'astro-icon/components';

/*
 * The signing sequence, steppable.
 *
 * The layout is the argument. Your page sits in the MIDDLE, between the server
 * and the token, because it is the only one of the three that can talk to both:
 * a server cannot reach a USB port, and a token cannot reach the internet. Draw
 * them in that order and the four steps stop needing an explanation.
 *
 * The Wire on the homepage answers "how much crosses the network". This answers
 * "in what order, and where does the PIN live", which is a different question,
 * so the two are not the same interaction twice.
 *
 * Every caption is in the markup, not passed to a script. Two reasons: the CSP
 * forbids inline script, so define:vars is not available; and the whole
 * explanation should be readable with JavaScript off, which it is -- CSS shows
 * the caption matching data-step, and without JS step 1 stands as prose.
 */

const steps = [
  {
    n: 1,
    title: 'Which certificate?',
    side: 'token',
    out: 'list request',
    back: 'certificates',
    body: 'Your page asks the token what it holds. The extension carries the question to the helper app, which reads the certificates off the hardware and hands them back. Nothing is signed yet.',
  },
  {
    n: 2,
    title: 'Prepare the signature',
    side: 'server',
    out: 'the PDF',
    back: '32-byte hash',
    body: 'Your page posts the document and the chosen certificate to your own server. The server builds the signature structure inside the PDF, keeps the half-finished file on disk, and returns just the hash that needs signing.',
  },
  {
    n: 3,
    title: 'Sign the hash',
    side: 'token',
    out: '32 bytes',
    back: 'signature',
    body: 'The token signs those 32 bytes. The PIN prompt is a native dialog on the signer’s own machine, so the PIN never reaches the page, the browser, or the network.',
  },
  {
    n: 4,
    title: 'Put it back together',
    side: 'server',
    out: 'signature',
    back: 'download link',
    body: 'Your page returns the signature. The server embeds it, adds whatever timestamp and revocation data the profile calls for, and the finished file is ready where it always was.',
  },
];
---

<div class="seq" data-seq data-step="1" data-side="token">
  <!-- Decorative: every step's meaning is in its caption, which is what a
       screen reader gets. -->
  <div class="stage" aria-hidden="true">
    <div class="actor">
      <span class="ic"><Icon name="lucide:server" /></span>
      <span class="name">Your server</span>
      <span class="sub">holds the document</span>
      <span class="doc">
        <Icon name="lucide:file-text" />
        <span class="doc-name">invoice.pdf</span>
        <span class="sealed">signed</span>
      </span>
    </div>

    <div class="link" data-link="server">
      <span class="rail"></span>
      {
        steps
          .filter((s) => s.side === 'server')
          .map((s) => (
            <>
              <span class="pip out" data-for={s.n}>
                <span class="tag">{s.out}</span>
              </span>
              <span class="pip back" data-for={s.n}>
                <span class="tag">{s.back}</span>
              </span>
            </>
          ))
      }
    </div>

    <div class="actor mid">
      <span class="ic"><Icon name="lucide:globe" /></span>
      <span class="name">Your page</span>
      <span class="sub">talks to both</span>
    </div>

    <div class="link" data-link="token">
      <span class="rail"></span>
      {
        steps
          .filter((s) => s.side === 'token')
          .map((s) => (
            <>
              <span class="pip out" data-for={s.n}>
                <span class="tag">{s.out}</span>
              </span>
              <span class="pip back" data-for={s.n}>
                <span class="tag">{s.back}</span>
              </span>
            </>
          ))
      }
    </div>

    <div class="actor">
      <span class="ic"><Icon name="lucide:usb" /></span>
      <span class="name">Your token</span>
      <span class="sub">holds the key</span>
      <span class="pin">
        <Icon name="lucide:lock" />
        <span class="pin-text">PIN typed here</span>
      </span>
    </div>
  </div>

  <ol class="steps" role="group" aria-label="Signing sequence">
    {
      steps.map((s) => (
        <li>
          <button
            type="button"
            data-step-btn={s.n}
            data-side={s.side}
            aria-pressed={s.n === 1}
          >
            <span class="n">{s.n}</span>
            <span class="t">{s.title}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="captions" aria-live="polite">
    {steps.map((s) => <p data-caption={s.n}>{s.body}</p>)}
  </div>
</div>

<script>
  const seq = document.querySelector<HTMLElement>('[data-seq]');
  if (seq) {
    const btns = [...seq.querySelectorAll<HTMLButtonElement>('[data-step-btn]')];
    let timer: ReturnType<typeof setTimeout>;

    const show = (n: number) => {
      const btn = btns.find((b) => Number(b.dataset.stepBtn) === n);
      if (!btn) return;

      seq.dataset.step = String(n);
      seq.dataset.side = btn.dataset.side ?? 'token';

      /* The document lands on the server at step 2 and never leaves; the PIN
         badge belongs to step 3; "signed" only once step 4 has run. */
      seq.toggleAttribute('data-doc-on', n >= 2);
      seq.toggleAttribute('data-pin-on', n === 3);
      seq.toggleAttribute('data-sealed-on', n >= 4);

      btns.forEach((b) =>
        b.setAttribute('aria-pressed', String(b === btn))
      );

      /* Restart rather than queue a second run. */
      seq.classList.remove('run');
      void seq.offsetWidth;
      seq.classList.add('run');
      clearTimeout(timer);
      timer = setTimeout(() => seq.classList.remove('run'), 2600);
    };

    btns.forEach((b) =>
      b.addEventListener('click', () => show(Number(b.dataset.stepBtn)))
    );

    /* Arrow keys walk the sequence, which is what a person expects of a row of
       related buttons. */
    seq.addEventListener('keydown', (e) => {
      const i = btns.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const dir =
        e.key === 'ArrowDown' || e.key === 'ArrowRight'
          ? 1
          : e.key === 'ArrowUp' || e.key === 'ArrowLeft'
            ? -1
            : 0;
      if (!dir) return;
      e.preventDefault();
      const next = btns[(i + dir + btns.length) % btns.length];
      next.focus();
      show(Number(next.dataset.stepBtn));
    });

    show(1);
  }
</script>

<style>
  .seq {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  /* server — link — page — link — token. The middle column is the point. */
  .stage {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) minmax(60px, 1.1fr) minmax(0, 1fr)
      minmax(60px, 1.1fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--s-3);
  }

  .actor {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2px;
    min-width: 0;
  }

  .ic {
    color: var(--faint);
    margin-bottom: var(--s-1);
  }

  .ic :global(svg) {
    width: var(--icon-md);
    height: var(--icon-md);
  }

  /* The one in the middle is lit, because it is the one being explained. */
  .mid .ic {
    color: var(--green-ink);
  }

  .name {
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
  }

  .sub {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  /* The document appears on the server at step 2 and stays put. */
  .doc,
  .pin {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--s-3);
    padding: 3px var(--s-2);
    border-radius: var(--pill);
    font-size: var(--text-xs);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .doc {
    background: var(--green-soft);
    color: var(--green-ink);
    border: 1px solid var(--green);
    font-family: var(--mono);
  }

  .doc :global(svg) {
    width: var(--icon-xs);
    height: var(--icon-xs);
  }

  .pin {
    background: var(--action-soft);
    color: var(--action-ink);
    border: 1px solid var(--action);
  }

  .pin :global(svg) {
    width: var(--icon-xs);
    height: var(--icon-xs);
  }

  [data-doc-on] .doc,
  [data-pin-on] .pin {
    opacity: 1;
    transform: none;
  }

  .sealed {
    display: none;
    font-weight: var(--fw-semibold);
  }

  [data-sealed-on] .sealed {
    display: inline;
  }

  [data-sealed-on] .sealed::before {
    content: '· ';
  }

  /* ---- the links ---- */
  .link {
    position: relative;
    height: 44px;
    margin-top: 10px;
  }

  .rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: var(--hairline);
    transition: border-color var(--dur) var(--ease);
  }

  /* Only the leg in play is drawn solid. */
  [data-side='server'] [data-link='server'] .rail,
  [data-side='token'] [data-link='token'] .rail {
    border-top-color: var(--border-strong);
  }

  .pip {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: var(--pill);
    background: var(--green);
    box-shadow: 0 0 0 4px var(--green-soft);
    opacity: 0;
  }

  .pip.back {
    background: var(--action);
    box-shadow: 0 0 0 4px var(--action-soft);
  }

  .tag {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 12px;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--green-ink);
  }

  .pip.back .tag {
    bottom: auto;
    top: 12px;
    color: var(--action-ink);
  }

  /* Only the pip belonging to the active step runs, and only on its own leg.
     Written per step because CSS cannot compare two attributes. */
  .seq.run[data-step='1'] [data-link='token'] .pip.out[data-for='1'],
  .seq.run[data-step='2'] [data-link='server'] .pip.out[data-for='2'],
  .seq.run[data-step='3'] [data-link='token'] .pip.out[data-for='3'],
  .seq.run[data-step='4'] [data-link='server'] .pip.out[data-for='4'] {
    animation: leg-out 1.1s var(--ease) forwards;
  }

  .seq.run[data-step='1'] [data-link='token'] .pip.back[data-for='1'],
  .seq.run[data-step='2'] [data-link='server'] .pip.back[data-for='2'],
  .seq.run[data-step='3'] [data-link='token'] .pip.back[data-for='3'],
  .seq.run[data-step='4'] [data-link='server'] .pip.back[data-for='4'] {
    animation: leg-back 1.1s var(--ease) 1.25s forwards;
  }

  /* Requests originate at the page, so "out" runs away from the middle:
     leftwards down the server leg, rightwards down the token leg. */
  @keyframes leg-out {
    0% {
      left: 50%;
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      left: var(--away);
      opacity: 0;
    }
  }

  @keyframes leg-back {
    0% {
      left: var(--away);
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      left: 50%;
      opacity: 0;
    }
  }

  [data-link='server'] {
    --away: 0%;
  }

  [data-link='token'] {
    --away: 100%;
  }

  /* ---- the step list ---- */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--s-2);
  }

  .steps button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-align: left;
    padding: var(--s-3);
    border: var(--hairline);
    border-radius: var(--radius-sm);
    color: var(--dim);
    transition:
      border-color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .steps button:hover {
    background: var(--hover);
    color: var(--text);
  }

  .steps button[aria-pressed='true'] {
    border-color: var(--green);
    background: var(--green-soft);
    color: var(--text);
  }

  .n {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: var(--pill);
    background: var(--surface);
    border: var(--hairline);
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
  }

  .steps button[aria-pressed='true'] .n {
    background: var(--green);
    border-color: var(--green);
    color: var(--on-accent);
  }

  .t {
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
  }

  /* One caption is shown at a time. With JavaScript off, data-step stays 1 and
     step one's paragraph stands on its own. */
  .captions {
    max-width: var(--measure);
    min-height: 4lh;
  }

  .captions p {
    display: none;
    font-size: var(--text-sm);
    color: var(--dim);
  }

  [data-step='1'] p[data-caption='1'],
  [data-step='2'] p[data-caption='2'],
  [data-step='3'] p[data-caption='3'],
  [data-step='4'] p[data-caption='4'] {
    display: block;
  }

  /* --bp-md: the three actors stay side by side, the labels get out of the way. */
  @media (max-width: 768px) {
    .stage {
      grid-template-columns:
        minmax(0, 1fr) minmax(28px, 0.6fr) minmax(0, 1fr)
        minmax(28px, 0.6fr) minmax(0, 1fr);
      gap: var(--s-1);
    }

    .sub,
    .tag,
    .doc-name,
    .pin-text {
      display: none;
    }

    .doc :global(svg) {
      width: var(--icon-sm);
      height: var(--icon-sm);
    }

    /* Measured: 4, 5, 3 and 4 lines at this width. */
    .captions {
      min-height: 5lh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pip {
      animation: none !important;
    }
  }
</style>
