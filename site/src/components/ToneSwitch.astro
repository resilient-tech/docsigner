---
/*
 * Temporary scaffolding, not a feature. Seven treatments for the seam between
 * sections, switchable on any page and remembered across navigation, so the
 * choice can be made by looking rather than by imagining.
 *
 * Remove this component, public/tone.js, the marked block in Section.astro and
 * the two lines in Layout.astro once the call is made.
 */
const options = [
  { tone: '', label: 'Bands (ships today)' },
  { tone: 'flat', label: 'One tone, nothing' },
  { tone: 'objects', label: 'Object trays + rhythm' },
  { tone: 'tick', label: 'Accent tick on label' },
  { tone: 'measure', label: 'Rule at the measure' },
  { tone: 'numbers', label: 'Numbered labels' },
  { tone: 'rule', label: 'Rule, full width' },
];
---

<div class="tone">
  <label for="tone-pick">Sections</label>
  <select id="tone-pick" data-tone-pick>
    {options.map((o) => <option value={o.tone}>{o.label}</option>)}
  </select>
</div>

<script>
  const pick = document.querySelector<HTMLSelectElement>('[data-tone-pick]');
  const root = document.documentElement;

  const apply = (tone: string) => {
    if (tone) root.dataset.tone = tone;
    else delete root.dataset.tone;
    localStorage.setItem('tone', tone);
    if (pick) pick.value = tone;
  };

  pick?.addEventListener('change', () => apply(pick.value));
  apply(root.dataset.tone ?? '');
</script>

<style>
  .tone {
    position: fixed;
    right: var(--s-4);
    bottom: var(--s-4);
    z-index: var(--z-overlay);
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(var(--nav-blur));
    border: var(--hairline);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-menu);
  }

  label {
    font-size: var(--text-xs);
    color: var(--faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  select {
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
    color: var(--text);
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--radius-card);
    padding: var(--s-1) var(--s-2);
    cursor: pointer;
  }

  select:focus-visible {
    box-shadow: var(--focus-ring);
  }

  /* --bp-md: no room beside the content on a phone. */
  @media (max-width: 768px) {
    .tone {
      left: var(--s-4);
      justify-content: center;
    }
  }
</style>
