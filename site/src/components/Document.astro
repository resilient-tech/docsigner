---
import Stamp from './Stamp.astro';

interface Props {
  /* Page width. Everything inside is in em off this, so the document scales as
     one object rather than as a pile of independently tuned sizes. */
  width?: string;
}

const { width = '560px' } = Astro.props;

/*
 * The letterheaded invoice the two prototypes show: the desktop app canvas and
 * the ERPNext print preview. One component, so the two cannot drift apart the
 * way the hand-built copies did.
 *
 * It is deliberately short. A real invoice is about 44em of content across,
 * which at prototype size puts the body text at six pixels -- present, but not
 * readable, which is the same as absent. Fewer lines at 32em across is a
 * document you can read here, and the letterhead is the part that carries it.
 *
 * The letterhead is Resilient's real one, so the logo and the details are the
 * real details.
 */

const lines = [
  ['ERPNext implementation, Q1 2026', '4,20,000.00'],
  ['India Compliance, annual licence', '72,000.00'],
  ['Onboarding and data migration', '48,000.00'],
];
---

<div class="doc paper" style={`--doc-w: ${width}`}>
  <header class="lh">
    <div class="lh-l">
      <img
        class="logo"
        src="/rt-logo.png"
        alt="Resilient Software Services LLP"
        width="360"
        height="81"
      />
      <p class="addr">Prahladnagar, Ahmedabad 380015 &middot; GSTIN 24AAWFR1234K1ZP</p>
    </div>
    <p class="kind">Tax Invoice</p>
  </header>

  <div class="meta">
    <span>ACC-SINV-2026-0412</span>
    <span>11 Apr 2026</span>
    <span>Northwind Traders Pvt Ltd</span>
  </div>

  <table>
    <tbody>
      {lines.map(([d, a]) => (
        <tr><td>{d}</td><td class="num">{a}</td></tr>
      ))}
      <tr class="tot"><td>Total incl. IGST</td><td class="num">6,37,200.00</td></tr>
    </tbody>
  </table>

  <footer class="foot">
    <Stamp />
  </footer>
</div>

<style>
  /* One font-size drives every measurement below, so the page scales as a
     single object at any width. */
  .doc {
    width: var(--doc-w);
    font-size: calc(var(--doc-w) / 32);
    padding: 1.5em 1.7em 1.3em;
    display: flex;
    flex-direction: column;
    gap: 0.9em;
    line-height: 1.5;
  }

  .lh {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1em;
    padding-bottom: 0.7em;
    border-bottom: 1px solid var(--paper-ink);
  }

  .lh-l {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    min-width: 0;
  }

  /* The real lockup, at a size a letterhead would use. */
  .logo {
    width: 7.4em;
    height: auto;
  }

  .addr {
    font-size: 0.42em;
    opacity: 0.6;
  }

  .kind {
    flex: none;
    font-size: 0.4em;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid var(--paper-line);
    border-radius: 0.2em;
    padding: 0.5em 0.8em;
    white-space: nowrap;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em 1.4em;
    border-bottom: 1px dashed var(--paper-line);
    padding-bottom: 0.6em;
    font-size: 0.42em;
    opacity: 0.75;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.44em;
  }

  /* Dashed row rules: a print format's table, not a stack of paragraphs. */
  td {
    padding-block: 0.65em;
    border-bottom: 1px dashed var(--paper-line);
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tot td {
    font-weight: 600;
    border-bottom: 0;
    border-top: 1px solid var(--paper-ink);
  }

  /* The stamp sits where appearance.box puts it: bottom right.
     Scaled by 32/44, because the page above is 32em across where a real one is
     44 -- without it the stamp inherits the zoom and covers half the width. */
  .foot {
    margin-top: 0.3em;
    font-size: 0.73em;
    display: flex;
    justify-content: flex-end;
  }
</style>
