---
import { Icon } from 'astro-icon/components';

/*
 * How a token signs a document it never sees, made countable.
 *
 * Ported from design/prototypes/hero.html. The point of the interaction is that
 * one number does not move: pick a 1.8 GB file and 288 bytes is still 288 bytes.
 * That is the mechanism explained, not a boast -- a hash-based signer gets this
 * for free, and the reason it is here is that it is the shortest honest way to
 * say what the browser actually carries.
 */
---

<div class="wire-block">
  <div class="wire" data-wire>
    <div class="node">
      <span class="node-ic"><Icon name="lucide:server" aria-hidden="true" /></span>
      <span class="node-name" data-node-left>Your server</span>
      <span class="node-sub" data-doc-name>invoice_2026_0412.pdf</span>
    </div>

    <div class="line" aria-hidden="true">
      <span class="rail"></span>
      <span class="pip out"><span class="pip-label">32-byte hash</span></span>
      <span class="pip back"><span class="pip-label">signature</span></span>
    </div>

    <div class="node right">
      <span class="node-ic"><Icon name="lucide:usb" aria-hidden="true" /></span>
      <span class="node-name">Your token</span>
      <span class="node-sub">PIN stays this side</span>
    </div>
  </div>

  <div class="counters">
    <div class="counter held">
      <span class="counter-n" data-wire-bytes>288</span><span class="counter-u">bytes</span>
      <span class="counter-l">crossed the network</span>
    </div>
    <div class="counter">
      <span class="counter-n" data-doc-size>12.4</span><span
        class="counter-u"
        data-doc-unit>MB</span
      >
      <span class="counter-l">stayed where it was</span>
    </div>
  </div>

  <div class="picker">
    <span class="label" id="picker-label">Try a bigger document</span>
    <div class="chips" role="group" aria-labelledby="picker-label">
      <button type="button" class="chip" data-file="0">240 KB</button>
      <button type="button" class="chip active" data-file="1">12.4 MB</button>
      <button type="button" class="chip" data-file="2">1.8 GB</button>
    </div>
    <p class="picker-note" data-note aria-live="polite"></p>
  </div>
</div>

<script>
  const $ = (s: string) => document.querySelector(s);
  const $$ = (s: string) => [...document.querySelectorAll(s)];

  const FILES = [
    { name: 'statement_march.pdf', n: '240', u: 'KB', ratio: '853' },
    { name: 'invoice_2026_0412.pdf', n: '12.4', u: 'MB', ratio: '45,147' },
    { name: 'annual_report_2025.pdf', n: '1.8', u: 'GB', ratio: '6,710,192' },
  ];
  let file = 1;
  let timer: ReturnType<typeof setTimeout>;

  function render() {
    const f = FILES[file];
    $$('[data-doc-name]').forEach((e) => (e.textContent = f.name));
    const size = $('[data-doc-size]');
    const unit = $('[data-doc-unit]');
    if (size) size.textContent = f.n;
    if (unit) unit.textContent = f.u;

    const note = $('[data-note]');
    if (note) {
      note.textContent =
        `A ${f.n} ${f.u} file signs as fast as a 240 KB one. ` +
        `The number on the left is why.`;
    }

    $$('[data-file]').forEach((b) => {
      const on = Number((b as HTMLElement).dataset.file) === file;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', String(on));
    });

    /* One beat of movement, then still. Re-triggering restarts it rather than
       queueing a second run. */
    const w = $('[data-wire]');
    if (!w) return;
    w.classList.remove('run');
    void (w as HTMLElement).offsetWidth;
    w.classList.add('run');
    clearTimeout(timer);
    timer = setTimeout(() => w.classList.remove('run'), 2400);
  }

  $$('[data-file]').forEach((b) =>
    b.addEventListener('click', () => {
      file = Number((b as HTMLElement).dataset.file);
      render();
    })
  );

  render();
</script>

<style>
  .wire {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 2fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--s-4);
  }

  .node {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .node.right {
    text-align: right;
    align-items: flex-end;
  }

  .node-ic {
    color: var(--faint);
  }

  .node-ic :global(svg) {
    width: var(--icon-md);
    height: var(--icon-md);
  }

  .node-name {
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
  }

  .node-sub {
    font-size: var(--text-xs);
    color: var(--faint);
    font-family: var(--mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .line {
    position: relative;
    height: 40px;
  }

  .rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: var(--hairline);
  }

  .pip {
    position: absolute;
    top: 50%;
    left: 0;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: var(--pill);
    background: var(--green);
    box-shadow: 0 0 0 4px var(--green-soft);
    opacity: 0;
  }

  .pip-label {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 12px;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--green-ink);
  }

  .pip.back {
    background: var(--action);
    box-shadow: 0 0 0 4px var(--action-soft);
  }

  .pip.back .pip-label {
    bottom: auto;
    top: 12px;
    color: var(--action-ink);
  }

  .wire.run .pip.out {
    animation: pip-out 1.1s var(--ease) forwards;
  }

  .wire.run .pip.back {
    animation: pip-back 1.1s var(--ease) 1.2s forwards;
  }

  @keyframes pip-out {
    0% {
      left: 0;
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  @keyframes pip-back {
    0% {
      left: 100%;
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      left: 0;
      opacity: 0;
    }
  }

  .counters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: var(--hairline);
  }

  .counter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
  }

  .counter-n {
    font-size: var(--display-1);
    font-weight: var(--fw-semibold);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
    color: var(--dim);
  }

  .counter-u {
    font-size: var(--display-3);
    color: var(--faint);
  }

  .counter-l {
    flex-basis: 100%;
    font-size: var(--text-sm);
    color: var(--faint);
  }

  /* The number that does not move is the one that gets the colour. */
  .counter.held .counter-n,
  .counter.held .counter-u {
    color: var(--green-ink);
  }

  .counter.held .counter-l {
    color: var(--dim);
  }

  .picker {
    margin-top: var(--s-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  .picker .label {
    flex-basis: 100%;
  }

  .chips {
    display: flex;
    gap: var(--s-2);
  }

  /* Chip recipe: pill, hairline, --text-xs semibold; active takes the action
     tone's ink, border and tint. */
  .chip {
    height: var(--control-h-sm);
    padding-inline: var(--control-px-sm);
    border-radius: var(--pill);
    border: var(--hairline);
    color: var(--dim);
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  .chip:hover {
    color: var(--text);
  }

  .chip.active {
    color: var(--action-ink);
    border-color: var(--action);
    background: var(--action-soft);
  }

  .picker-note {
    flex: 1;
    min-width: 260px;
    margin: 0;
    max-width: 52ch;
    font-size: var(--text-sm);
    color: var(--dim);
  }

  /* --bp-sm. The three-column wire cannot hold two labelled nodes and a rail in
     a phone's width without truncating both names, so it stacks and the rail
     turns vertical. */
  @media (max-width: 640px) {
    .wire {
      grid-template-columns: 1fr;
      gap: var(--s-2);
      justify-items: start;
    }

    .node.right {
      text-align: left;
      align-items: flex-start;
    }

    .node-sub {
      white-space: normal;
    }

    .line {
      height: 28px;
      width: 100%;
    }

    .rail {
      left: 10px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 0;
      border-top: 0;
      border-left: var(--hairline);
    }

    /* The pips travel down the vertical rail instead of along a horizontal one,
       and their labels sit beside it. */
    .pip {
      left: 6px;
      margin-top: 0;
    }

    .pip-label {
      left: 16px;
      right: auto;
      bottom: -4px;
      transform: none;
    }

    .pip.back .pip-label {
      top: -4px;
      bottom: auto;
    }

    .wire.run .pip.out {
      animation-name: pip-down;
    }

    .wire.run .pip.back {
      animation-name: pip-up;
    }

    @keyframes pip-down {
      0% {
        top: 0;
        opacity: 0;
      }
      12%,
      88% {
        opacity: 1;
      }
      100% {
        top: 100%;
        opacity: 0;
      }
    }

    @keyframes pip-up {
      0% {
        top: 100%;
        opacity: 0;
      }
      12%,
      88% {
        opacity: 1;
      }
      100% {
        top: 0;
        opacity: 0;
      }
    }
  }
</style>
