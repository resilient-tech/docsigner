---
/*
 * Which platform the downloads on this page are for.
 *
 * Hidden until the script on /download sets html[data-platform]: with no
 * JavaScript there is nothing to switch and every download renders anyway.
 *
 * It appears once per download section rather than once per page. The chooser
 * nav links straight to #desktop, so a reader can arrive below any single
 * instance; every instance reads and writes the same attribute, and the page's
 * one delegated click handler already collects all of them, so two switches
 * cannot drift out of step.
 */

interface Props {
  platforms: { os: string; title: string }[];
}

const { platforms } = Astro.props;
---

<div class="platform">
  <span class="pl-label">Downloads for</span>
  <div class="seg" role="group" aria-label="Your platform">
    {
      platforms.map((p) => (
        <button type="button" data-platform-pick={p.os} aria-pressed="false">
          {p.title}
        </button>
      ))
    }
  </div>
</div>

<style>
  .platform {
    display: none;
    align-items: center;
    gap: var(--s-3);
  }

  :global(html[data-platform]) .platform {
    display: flex;
    flex-wrap: wrap;
  }

  .pl-label {
    font-size: var(--text-sm);
    color: var(--dim);
  }

  .seg {
    display: flex;
    gap: 2px;
    padding: 3px;
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--pill);
  }

  .seg button {
    font: inherit;
    font-size: var(--text-sm);
    color: var(--dim);
    background: none;
    border: 0;
    border-radius: var(--pill);
    padding: var(--s-1) var(--s-4);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  .seg button:hover {
    color: var(--text);
  }

  .seg button[aria-pressed='true'] {
    background: var(--green-soft);
    color: var(--green-ink);
    font-weight: var(--fw-semibold);
  }
</style>
