---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  variant?: 'primary' | 'default' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  trailing?: string;
  type?: 'button' | 'submit';
  id?: string;
  disabled?: boolean;
  class?: string;
}

const {
  href,
  variant = 'default',
  size = 'md',
  icon,
  trailing,
  type = 'button',
  id,
  disabled,
  class: extra,
} = Astro.props;

/* An href makes it a link, otherwise a button. Saves an `as` prop nobody would
   remember to pass. */
const Tag = href ? 'a' : 'button';
const external = href?.startsWith('http');
const attrs = href
  ? { href, ...(external ? { rel: 'noopener' } : {}) }
  : { type, disabled };
const cls = ['btn', variant, size, extra].filter(Boolean).join(' ');
---

<Tag class={cls} id={id} {...attrs}>
  {icon && <Icon name={icon} aria-hidden="true" />}
  <slot />
  {trailing && <Icon name={trailing} aria-hidden="true" />}
</Tag>

<style>
  /* Per design/design-system.md: control heights, --control-px-* padding,
     --radius-sm, and a transparent 1px border on every variant so swapping
     variants changes a colour and never reflows. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    font-family: var(--font);
    font-weight: var(--fw-semibold);
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .sm {
    height: var(--control-h-sm);
    padding-inline: var(--control-px-sm);
  }
  .md {
    height: var(--control-h-md);
    padding-inline: var(--control-px-md);
  }
  .lg {
    height: var(--control-h-lg);
    padding-inline: var(--control-px-lg);
    font-size: var(--text-body);
  }

  /* One per view. It is the signing action. No border: the fill is the
     statement, and the focus ring carries its own ground-coloured band so it
     stays visible on mint without one. */
  .primary {
    background: var(--green);
    color: var(--on-accent);
  }
  .primary:hover:not(:disabled) {
    background: var(--green-hover);
  }

  .default {
    background: var(--surface);
    border: var(--hairline);
    color: var(--text);
  }
  .default:hover:not(:disabled) {
    background: var(--hover);
  }

  .ghost {
    border: var(--hairline);
    color: var(--dim);
  }
  .ghost:hover:not(:disabled) {
    background: var(--hover);
    color: var(--text);
  }

  /* Text and a tint on hover, never a red fill. A red fill in this system
     means a verification failed. */
  .danger {
    color: var(--red-ink);
  }
  .danger:hover:not(:disabled) {
    background: var(--red-soft);
  }

  .btn :global(svg) {
    width: var(--icon-sm);
    height: var(--icon-sm);
  }
</style>
