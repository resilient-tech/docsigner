---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  variant?: 'primary' | 'default' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  trailing?: string;
  type?: 'button' | 'submit';
  id?: string;
  disabled?: boolean;
  class?: string;
}

const {
  href,
  variant = 'default',
  size = 'md',
  icon,
  trailing,
  type = 'button',
  id,
  disabled,
  class: extra,
} = Astro.props;

/* An href makes it a link, otherwise a button. Saves a `as` prop nobody would
   remember to pass. */
const Tag = href ? 'a' : 'button';
const external = href?.startsWith('http');
const attrs = href
  ? { href, ...(external ? { rel: 'noopener' } : {}) }
  : { type, disabled };
const cls = ['btn', variant, size, extra].filter(Boolean).join(' ');
---

<Tag class={cls} id={id} {...attrs}>
  {icon && <Icon name={icon} aria-hidden="true" />}
  <slot />
  {trailing && <Icon name={trailing} aria-hidden="true" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    font-family: var(--font);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .sm {
    font-size: var(--text-sm);
    padding: 0 var(--s-3);
    height: 32px;
  }
  .md {
    font-size: var(--text-sm);
    padding: 0 var(--s-4);
    height: 38px;
  }
  .lg {
    font-size: var(--text-body);
    padding: 0 var(--s-6);
    height: 46px;
  }

  /* Mint fill, dark ink. Same pairing as the logo tile, and it holds on both
     themes without a second colour. */
  .primary {
    background: var(--green);
    color: var(--on-accent);
  }
  .primary:hover:not(:disabled) {
    background: #3fbf6f;
  }

  .default {
    background: var(--surface);
    border-color: var(--border-strong);
    color: var(--text);
  }
  .default:hover:not(:disabled) {
    background: var(--hover);
  }

  .ghost {
    background: transparent;
    color: var(--dim);
  }
  .ghost:hover:not(:disabled) {
    background: var(--hover);
    color: var(--text);
  }

  .btn :global(svg) {
    width: 1.05em;
    height: 1.05em;
    flex: none;
  }
</style>
