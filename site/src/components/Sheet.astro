---
import SignatureBox from './SignatureBox.astro';

interface Props {
  /* Sheet width. One viewBox holds everything, so this is the only size.
     520px renders the drawing at exactly the width the hero renders it, which
     is what keeps the rules the same weight and the corners still rounded --
     narrower and rx="0.8" falls below a pixel and the lines read as hairlines. */
  width?: string;
}

const { width = '520px' } = Astro.props;

/*
 * The page the prototypes show. Body geometry is HeroSheet's, unchanged, with a
 * letterhead added on top: the leaf, the firm name, and nothing else.
 *
 * Greeked lines, not invoice copy. Real text at this size lands at six or seven
 * pixels, which is present but not readable, and the document is scenery for
 * the signature either way.
 *
 * HeroSheet is the hero's frozen copy of the same drawing. This one carries the
 * letterhead and the signing states, so it is the one that moves.
 *
 * .paper (design/base.css) supplies the sheet itself. Paper has no dark mode:
 * in the dark theme this is the one bright object on the screen, which is the
 * picture worth making.
 */

/* The letterhead band on top, and how far it pushes the body down. */
const band = 10;
---

<div class="sheet paper" style={`--sheet-w: ${width}`} aria-hidden="true">
  <svg viewBox={`0 0 340 ${250 + band}`}>
    <image href="/rt-leaf.png" x="0" y="0" width="26" height="14" />
    <text
      x="33"
      y="12"
      font-size="11.5"
      font-weight="600"
      fill="var(--paper-ink)"
      font-family="system-ui, sans-serif">Resilient Software Services LLP</text>

    <g transform={`translate(0 ${band})`}>
      <rect x="0" y="24" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />
      <rect x="0" y="35" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />
      <rect x="0" y="46" width="268" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />

      <rect x="0" y="72" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />
      <rect x="0" y="83" width="286" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />
      <rect x="0" y="94" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />
      <rect x="0" y="105" width="232" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />

      <rect x="0" y="130" width="188" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />
      <rect x="0" y="141" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />
      <rect x="0" y="152" width="146" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16" />

      <g class="sig" data-sig>
        <SignatureBox x={0} y={176} size={180} />
      </g>
    </g>
  </svg>
</div>

<style>
  /* The viewBox carries every proportion, so width is the only measurement here.
     The margin is padding on the sheet rather than space in the viewBox, because
     .paper's border and radius have to sit outside the drawing. Same padding as
     the hero's .hero-art, so the drawing lands at the same scale. */
  .sheet {
    width: var(--sheet-w);
    padding: var(--s-6) var(--s-6) var(--s-8);
    box-sizing: border-box;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
