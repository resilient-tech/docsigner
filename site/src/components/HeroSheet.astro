---
import { signedAt } from '../lib/demo';
/*
 * The artifact: a page with a signature and a verification QR on it, drawn
 * rather than screenshotted so it takes the theme's --paper tokens and stays
 * sharp at any size. Lifted verbatim from design/prototypes/hero.html, which
 * generates it; this is the rendered output, so there is no build step here.
 *
 * .paper (design/base.css) supplies the sheet itself. Paper has no dark mode:
 * in the dark theme this is the one bright object on the screen, which is the
 * picture worth making.
 */
---

<svg class="hero-sheet" viewBox="0 0 340 250" aria-hidden="true">
  <rect x="0" y="6" width="126" height="3.8" rx="1.9" fill="var(--paper-ink)" opacity="0.5"/>
  <rect x="0" y="24" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/><rect x="0" y="35" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/><rect x="0" y="46" width="268" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/>
  <rect x="0" y="72" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/><rect x="0" y="83" width="286" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/><rect x="0" y="94" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/><rect x="0" y="105" width="232" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/>
  <rect x="0" y="130" width="188" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/><rect x="0" y="141" width="300" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/><rect x="0" y="152" width="146" height="2.8" rx="1.4" fill="var(--paper-ink)" opacity="0.16"/>
  <g transform="translate(0 176)">
    <rect x="0" y="0" width="180" height="60" rx="3" fill="none"
          stroke="var(--paper-ink)" stroke-width="1" opacity="0.22"/>
    <path class="ink" pathLength="1"
          d="M14 31c11-3 16-19 22-21s8 10 3 16-11 4-8-2 12-11 21-11 13 8 22 6 12-10 19-10"
          fill="none" stroke="var(--paper-ink)" stroke-width="2.1" stroke-linecap="round"
          stroke-linejoin="round" opacity="0.88"/>
    <image href="/qr-resilient.svg" x="133" y="9" width="42" height="42" opacity="0.85"/>
    <rect x="14" y="40" width="112" height="1.1" fill="var(--paper-ink)" opacity="0.22"/>
    <text x="14" y="50" font-size="6.4" fill="var(--paper-ink)" opacity="0.72"
          font-family="system-ui, sans-serif">Digitally signed by SMIT VORA</text>
    <text x="14" y="57" font-size="5.4" fill="var(--paper-ink)" opacity="0.5"
          font-family="system-ui, sans-serif">{signedAt}</text>
  </g>
</svg>

<style>
  .hero-sheet {
    width: 100%;
    height: auto;
    display: block;
  }

  /* The signature draws itself once, on load, then holds. pathLength="1" on the
     path lets one dash rule drive it regardless of the path's real length.
     This is the moment on the page, so nothing else animates on arrival. */
  .hero-sheet .ink {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ink-draw 1500ms var(--ease) 400ms forwards;
  }

  @keyframes ink-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Drawn, not animated: the signature is the point, so it stays visible. */
  @media (prefers-reduced-motion: reduce) {
    .hero-sheet .ink {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
