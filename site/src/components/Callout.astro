---
import { Icon } from 'astro-icon/components';

interface Props {
  /* The three tones the system has. note is context; warn is something that
     will bite you; fail is a check that did not pass. */
  tone?: 'note' | 'warn' | 'fail';
  title?: string;
}

const { tone = 'note', title } = Astro.props;

const icons = {
  note: 'lucide:info',
  warn: 'lucide:triangle-alert',
  fail: 'lucide:circle-x',
} as const;
---

<aside class={`callout ${tone}`}>
  <Icon name={icons[tone]} aria-hidden="true" />
  <div>
    {title && <p class="title">{title}</p>}
    <slot />
  </div>
</aside>

<style>
  /* Hairline all round, the accent bar on the leading edge in the tone's -ink.
     Ground is --surface for note, the tone's own tint otherwise. */
  .callout {
    display: flex;
    gap: var(--s-3);
    border: var(--hairline);
    border-left-width: var(--accent-bar);
    border-radius: var(--radius-sm);
    padding: var(--s-4);
    font-size: var(--text-body);
    color: var(--text);
    background: var(--surface);
  }

  /* Bigger than the base 16px. A warning icon has to carry from a glance. */
  .callout :global(svg) {
    width: var(--icon-md);
    height: var(--icon-md);
    margin-top: 1px;
  }

  .title {
    font-weight: var(--fw-semibold);
    color: var(--text);
    margin-bottom: var(--s-1);
  }

  .callout :global(p + p) {
    margin-top: var(--s-2);
  }

  .note {
    border-left-color: var(--action-ink);
  }
  .note :global(svg) {
    color: var(--action-ink);
  }

  .warn {
    border-left-color: var(--amber-ink);
    background: var(--amber-soft);
  }
  .warn :global(svg) {
    color: var(--amber-ink);
  }

  .fail {
    border-left-color: var(--red-ink);
    background: var(--red-soft);
  }
  .fail :global(svg) {
    color: var(--red-ink);
  }
</style>
