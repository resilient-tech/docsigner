---
interface Props {
  /* The signed-by line. "Digitally signed by" is what appearance.py writes on
     the QR path; "Signed by" is DEFAULT_TEXT's wording without one. */
  name?: string;
  when?: string;
  qr?: boolean;
  /* Draw the mark on load, once. Only the hero asks for this. */
  draw?: boolean;
}

const {
  name = 'SMIT VORA',
  when = '2026-04-11 14:32 +05:30',
  qr = true,
  draw = false,
} = Astro.props;

/*
 * The signature stamp, once, for every place one appears.
 *
 * There used to be three hand-tuned copies of this mark and they had drifted:
 * different path, different stroke, different box. This is the one.
 *
 * Sized in em so it scales with whatever document it sits on. On A4 a DSC box
 * is roughly 180x60pt, which is about a third of the page width, and that is
 * what the em values here work out to.
 *
 * It is the product's `image` appearance style: a drawn mark rather than a name
 * set in GreatVibes. The font is the other real option and costs 89KB.
 */
---

<span class="stamp" data-stamp>
  <span class="mark" aria-hidden="true">
    <svg viewBox="0 0 120 44">
      <path
        class:list={['ink', { draw }]}
        pathLength="1"
        d="M8 30c11-3 16-19 22-21s8 10 3 16-11 4-8-2 12-11 21-11 13 8 22 6 12-10 19-10"
        fill="none"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>

  <span class="txt">
    <b>Digitally signed by {name}</b>
    <em>{when}</em>
    {qr && <i>Scan to verify</i>}
  </span>

  {
    qr && (
      <img class="qr" src="/qr-resilient.svg" alt="" width="52" height="52" loading="lazy" />
    )
  }
</span>

<style>
  .stamp {
    display: flex;
    align-items: center;
    gap: 0.5em;
    width: fit-content;
    padding: 0.35em 0.45em;
    border: 1px solid var(--paper-line);
    border-radius: 0.15em;
    color: var(--paper-ink);
    line-height: 1.35;
  }

  .mark {
    flex: none;
    width: 4.2em;
    opacity: 0.85;
  }

  .mark svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .txt b {
    font-size: 0.52em;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .txt em {
    font-size: 0.46em;
    font-style: normal;
    opacity: 0.62;
  }

  .txt i {
    font-size: 0.4em;
    font-style: normal;
    opacity: 0.45;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Softer and smaller than a screen QR. A stamp is printed at a few
     millimetres, so full-contrast crisp black reads as pasted on. */
  .qr {
    flex: none;
    width: 3.1em;
    height: 3.1em;
    opacity: 0.78;
    border-radius: 1px;
  }

  /* The hero draws it once on load. pathLength="1" lets one dash rule drive it
     whatever the real path length is. */
  .ink.draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ink-draw 1500ms var(--ease) 400ms forwards;
  }

  @keyframes ink-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink.draw {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
