---
interface Props {
  /* Alternating ground. Sections stack bg / deep / bg so the eye gets a break
     without a border on every seam. */
  ground?: 'bg' | 'deep';
  label?: string;
  title?: string;
  lede?: string;
  id?: string;
  /* Centres the heading block. Off by default: left-aligned reads faster. */
  centre?: boolean;
  /*
   * Fill the viewport. Only the homepage hero uses it: a landing screen earns
   * its height by being the whole statement, and every other section on the
   * site is shorter than a screen's worth of content. Four full-height bands in
   * a row just moved the same content further apart.
   */
  full?: boolean;
  class?: string;
}

const {
  ground = 'bg',
  label,
  title,
  lede,
  id,
  centre,
  full,
  class: extra,
} = Astro.props;

const cls = ['section', ground, centre && 'centre', full && 'full', extra]
  .filter(Boolean)
  .join(' ');
---

<section class={cls} id={id}>
  <div class="wrap inner">
    {
      (label || title || lede) && (
        <header class="head">
          {label && <p class="label">{label}</p>}
          {title && <h2>{title}</h2>}
          {lede && <p class="lede">{lede}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
  }

  .bg {
    background: var(--bg);
  }

  .deep {
    background: var(--bg-deep);
  }

  /* ----------------------------------------------------------------------
     Comparison switch, temporary: see components/ToneSwitch.astro.

     Every variant below is one tone. What differs is what replaces the band.
     ---------------------------------------------------------------------- */
  :global(:root[data-tone]) .deep {
    background: var(--bg);
  }

  /* rule: a hairline the full width of the page. */
  :global(:root[data-tone='rule']) .section + .section {
    border-top: var(--hairline);
  }

  /* objects: the recess becomes a property of the thing that needed framing
     rather than of the page it sits on, and the rhythm carries the seam. A
     section with a label is starting a subject and gets the full measure of
     air; one without is continuing, and gets less. */
  :global(:root[data-tone='objects']) .section:not(:has(.label)) {
    padding-block: var(--s-16);
  }

  :global(:root[data-tone='objects'] .chooser),
  :global(:root[data-tone='objects'] .seq) {
    background: var(--bg-deep);
    border: var(--hairline);
    border-radius: var(--radius-lg);
    padding: var(--s-6);
  }

  /* The page hero draws its own hairline seam. Under any variant that goes, or
     "one tone, nothing" still has a line in it and the comparison is muddied. */
  :global(:root[data-tone] .hero) {
    border-bottom: 0;
  }

  /* tick: the site's own accent, at the size the nav and the callouts use it.
     Hero's kicker is a .label too, so it gets one; DownloadCard's <dt> is also a
     .label and must not, which is why this is not simply .label everywhere. */
  :global(:root[data-tone='tick'] .hero .label::before),
  :global(:root[data-tone='tick']) .label::before {
    content: '';
    display: block;
    width: 22px;
    height: var(--accent-bar);
    margin-bottom: var(--s-3);
    border-radius: var(--pill);
    background: var(--green);
  }

  /* measure: a rule inside a document, not a division between slabs. */
  :global(:root[data-tone='measure']) .section + .section > .inner::before {
    content: '';
    display: block;
    max-width: var(--measure);
    height: 1px;
    margin-bottom: var(--s-12);
    background: var(--border);
  }

  /* numbers: reset on the root rather than on body, because an inline style
     attribute is exactly what our own CSP forbids. Only sections that announce
     a subject take a number, or the count jumps over the hero and the closing
     block. */
  :global(:root[data-tone='numbers']) {
    counter-reset: sec;
  }

  :global(:root[data-tone='numbers']) .section:has(.label) {
    counter-increment: sec;
  }

  :global(:root[data-tone='numbers']) .label::before {
    content: counter(sec, decimal-leading-zero) ' \2014\a0';
    color: var(--green-ink);
  }

  :global(:root[data-tone='rule']) .section + .section {
    border-top: var(--hairline);
  }

  /* svh, not vh: on a phone, vh is the tallest the viewport ever gets, so a
     100vh band sits partly under the URL bar until you scroll.

     Content starts at the top, it does not centre. Centring a 400px block in an
     840px band puts 200px of nothing above the heading. Only the hero is full
     now, and there the air is the point, so full implies centred and there is no
     second flag to forget to pass.

     `safe center`, not `center`: plain centring overflows a grid in both
     directions, so on a phone the hero centred itself into a band shorter than
     itself, leaving dead space above the fold and the call to action below it.
     safe falls back to start the moment the content stops fitting.

     The height subtracts the nav rather than padding it out. The nav is sticky,
     which means it is in normal flow and takes its 60px above this section, so a
     full 100svh here made the first screen 960px tall: it overshot the viewport
     by exactly the nav, put a scrollbar on a page that should not have one, and
     left the centred content sitting low. */
  .full {
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    align-content: safe center;
    padding-block: var(--s-8);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-bottom: var(--s-12);
    max-width: var(--measure);
  }

  .centre .head {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  /* --bp-md */
  @media (max-width: 768px) {
    .section {
      padding-block: var(--s-16);
    }
    .head {
      margin-bottom: var(--s-8);
    }
    .full {
      padding-block: var(--s-6);
    }
  }
</style>
