---
interface Props {
  /* Alternating ground. Sections stack bg / deep / bg so the eye gets a break
     without a border on every seam. */
  ground?: 'bg' | 'deep';
  label?: string;
  title?: string;
  lede?: string;
  id?: string;
  /* Centres the heading block. Off by default: left-aligned reads faster. */
  centre?: boolean;
  /*
   * Fill the viewport. Only the homepage hero uses it: a landing screen earns
   * its height by being the whole statement, and every other section on the
   * site is shorter than a screen's worth of content. Four full-height bands in
   * a row just moved the same content further apart.
   */
  full?: boolean;
  class?: string;
}

const {
  ground = 'bg',
  label,
  title,
  lede,
  id,
  centre,
  full,
  class: extra,
} = Astro.props;

const cls = ['section', ground, centre && 'centre', full && 'full', extra]
  .filter(Boolean)
  .join(' ');
---

<section class={cls} id={id}>
  <div class="wrap inner">
    {
      (label || title || lede) && (
        <header class="head">
          {label && <p class="label">{label}</p>}
          {title && <h2>{title}</h2>}
          {lede && <p class="lede">{lede}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
  }

  .bg {
    background: var(--bg);
  }

  .deep {
    background: var(--bg-deep);
  }

  /* svh, not vh: on a phone, vh is the tallest the viewport ever gets, so a
     100vh band sits partly under the URL bar until you scroll.

     Content starts at the top, it does not centre. Centring a 400px block in an
     840px band puts 200px of nothing above the heading. Only the hero is full
     now, and there the air is the point, so full implies centred and there is no
     second flag to forget to pass.

     `safe center`, not `center`: plain centring overflows a grid in both
     directions, so on a phone the hero centred itself into a band shorter than
     itself, leaving dead space above the fold and the call to action below it.
     safe falls back to start the moment the content stops fitting.

     The height subtracts the nav rather than padding it out. The nav is sticky,
     which means it is in normal flow and takes its 60px above this section, so a
     full 100svh here made the first screen 960px tall: it overshot the viewport
     by exactly the nav, put a scrollbar on a page that should not have one, and
     left the centred content sitting low. */
  .full {
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    align-content: safe center;
    padding-block: var(--s-8);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-bottom: var(--s-12);
    max-width: var(--measure);
  }

  .centre .head {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  /* --bp-md */
  @media (max-width: 768px) {
    .section {
      padding-block: var(--s-16);
    }
    .head {
      margin-bottom: var(--s-8);
    }
    .full {
      padding-block: var(--s-6);
    }
  }
</style>
