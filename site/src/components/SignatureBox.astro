---
import { signedAt } from '../lib/demo';
interface Props {
  /* Placement inside a parent viewBox. Left off, the box is standalone and CSS
     sizes it. A nested <svg> is the only way to reuse this: bare SVG children
     at an Astro template's root get parsed as HTML, where <image> means <img>
     and <text> means nothing at all. */
  x?: number;
  y?: number;
  size?: number;
  /* The box rule around it. The setup panel's field has its own border, and
     two rounded rectangles a pixel apart look like a mistake. */
  frame?: boolean;
  class?: string;
}

const { x, y, size, frame = true, class: extra } = Astro.props;
const placed = x !== undefined;

/*
 * The signature stamp, at the hero's geometry unchanged: a 180x60 box, the mark
 * across the top, a rule under it, the signed-by lines below and the QR to the
 * right.
 *
 * That is the product's `image` appearance style, and the QR is real --
 * generated with the same qrcode settings appearance.py uses, so it resolves to
 * resilient.tech.
 */
---

<svg
  class:list={['sigbox', extra]}
  viewBox={frame ? '0 0 180 60' : '10 4 162 54'}
  x={placed ? x : undefined}
  y={placed ? y : undefined}
  width={placed ? size : undefined}
  height={placed ? size! / 3 : undefined}
  aria-hidden="true"
>
  {
    frame && (
      <rect
        x="0"
        y="0"
        width="180"
        height="60"
        rx="3"
        fill="none"
        stroke="var(--paper-ink)"
        stroke-width="1"
        opacity="0.22"
      />
    )
  }
  <path
    class="ink"
    pathLength="1"
    d="M14 31c11-3 16-19 22-21s8 10 3 16-11 4-8-2 12-11 21-11 13 8 22 6 12-10 19-10"
    fill="none"
    stroke="var(--paper-ink)"
    stroke-width="2.1"
    stroke-linecap="round"
    stroke-linejoin="round"
    opacity="0.88"
  />
  <image href="/qr-resilient.svg" x="133" y="9" width="42" height="42" opacity="0.85" />
  <rect x="14" y="40" width="112" height="1.1" fill="var(--paper-ink)" opacity="0.22" />
  <text
    x="14"
    y="50"
    font-size="6.4"
    fill="var(--paper-ink)"
    opacity="0.72"
    font-family="system-ui, sans-serif">Digitally signed by SMIT VORA</text>
  <text
    x="14"
    y="57"
    font-size="5.4"
    fill="var(--paper-ink)"
    opacity="0.5"
    font-family="system-ui, sans-serif">{signedAt}</text>
</svg>

<style>
  /* The mark writes itself while a surface is signing, which is the same moment
     the hero's does on load. A fade read as a picture appearing; this reads as
     signing. pathLength="1" lets one dash rule drive it whatever the real path
     length is.

     Scoped under [data-sig] so the setup panel's preview, which is a settings
     value and not an event, stays still. */
  /* Undrawn is the resting state on a page waiting to be signed, so there is no
     frame where the finished mark shows before the animation resets it. */
  :global([data-sig]) .ink {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.signing [data-sig]) .ink {
    animation: ink-draw 1200ms var(--ease) 250ms forwards;
  }

  @keyframes ink-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Drawn, not animated: the signature is the point, so it stays visible. */
  /* Drawn, not animated: the signature is the point, so it appears whole. */
  @media (prefers-reduced-motion: reduce) {
    :global([data-sig]) .ink {
      stroke-dashoffset: 0;
    }

    :global(.signing [data-sig]) .ink {
      animation: none;
    }
  }
</style>
