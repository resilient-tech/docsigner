---
import { Icon } from 'astro-icon/components';

/* No aria-pressed. The accessible name already says what the click does, and
   the two together read as "switch to dark theme, toggle button, not pressed".
   Square control, so it sits at --control-sq and lines up with a sm button. */
---

<button type="button" class="toggle">
  <Icon name="lucide:sun" class="sun" aria-hidden="true" />
  <Icon name="lucide:moon" class="moon" aria-hidden="true" />
  <span class="sr-only">Switch to paper theme</span>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.toggle');
  const label = btn?.querySelector('.sr-only');

  const sync = () => {
    const paper = document.documentElement.dataset.theme === 'paper';
    const next = paper ? 'dark' : 'paper';
    if (label) label.textContent = `Switch to ${next} theme`;
    btn?.setAttribute('title', `Switch to ${next} theme`);
  };

  btn?.addEventListener('click', () => {
    const paper = document.documentElement.dataset.theme === 'paper';
    if (paper) delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = 'paper';
    try {
      localStorage.setItem('theme', paper ? 'dark' : 'paper');
    } catch {
      /* Nothing to do. The choice holds for this page either way. */
    }
    sync();
  });

  sync();
</script>

<style>
  /* No border. A boxed icon in the corner of a bare nav reads as a stray
     control; the glyph alone is enough, and hover carries the affordance. Same
     treatment as the source link beside it, so the pair looks like a pair. */
  .toggle {
    display: grid;
    place-items: center;
    width: var(--control-sq);
    height: var(--control-sq);
    border-radius: var(--radius-sm);
    color: var(--dim);
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  .toggle:hover {
    background: var(--hover);
    color: var(--text);
  }

  /* Both glyphs share the cell. The one drawn is the theme a click would give
     you, which is what the accessible name says too. */
  .toggle :global(svg) {
    grid-area: 1 / 1;
  }

  .toggle :global(.moon) {
    display: none;
  }

  :global(:root[data-theme='paper']) .toggle :global(.moon) {
    display: block;
  }

  :global(:root[data-theme='paper']) .toggle :global(.sun) {
    display: none;
  }
</style>
