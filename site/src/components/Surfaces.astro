---
import { Icon } from 'astro-icon/components';

/*
 * The same signature, in the three places it gets made. Ported from
 * design/prototypes/hero-body.html.
 *
 * Tabs are radio inputs, so switching costs no JavaScript.
 *
 * Nothing is scaled. The prototype rendered each surface at its natural width
 * and then transformed it to fit, which put the desktop app at 0.42 on a phone
 * with the file list around 5px. The web surface reflows; the two that cannot
 * (a three-pane window, a wide invoice) scroll sideways inside their own frame
 * at full size. Swiping a window is honest, squinting at one is not.
 *
 * Strings are the real ones. The certificate line follows demo/demo.js:167,
 * "CN (signing, <token label>, valid until <date>)"; ePass2003 is a reader name
 * host/src/pcsc_readers.rs recognises; CCA-LTA is a profile the server accepts.
 */

const tabs = [
  { id: 'web', label: 'On your own site', caption: 'demo/, the page a developer wires up' },
  { id: 'app', label: 'In the desktop app', caption: 'desktop/, batch-signing a folder' },
  { id: 'erp', label: 'In ERPNext', caption: 'docsigner_integration, signing on submit' },
];
---

<div class="surfaces">
  {
    tabs.map((t, i) => (
      <input type="radio" name="surface" id={`s-${t.id}`} checked={i === 0} />
    ))
  }

  <div class="tablist" role="group" aria-label="Where signing happens">
    {tabs.map((t) => <label for={`s-${t.id}`}>{t.label}</label>)}
  </div>

  <div class="panels">
    <!-- ------------------------------------------------ 1. the web page -->
    <figure class="panel">
      <div class="frame">
        <div class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="url">
            <Icon name="lucide:lock" aria-hidden="true" />
            accounts.yourcompany.in/invoices/4412
          </span>
        </div>
        <div class="body">
          <div class="web">
            <div class="card">
              <p class="card-head label"><span class="step">1</span> Document</p>
              <div class="field">
                <span class="flabel">What to sign</span>
                <span class="control">PDF (PAdES / CCA signature inside the file)</span>
              </div>
              <span class="control file">invoice_2026_0412.pdf</span>
            </div>
            <div class="card">
              <p class="card-head label">
                <span class="step">2</span> Certificate <span class="state">1 found</span>
              </p>
              <div class="field">
                <span class="flabel">Signer</span>
                <span class="control">Smit Vora (signing, ePass2003, valid until 2027-04-11)</span>
              </div>
            </div>
            <div class="card">
              <p class="card-head label"><span class="step">3</span> Signature</p>
              <div class="field">
                <span class="flabel">Profile</span>
                <span class="control">CCA-LTA (India: CCA-LTV plus RFC 3161 timestamp)</span>
              </div>
            </div>
            <span class="cta">Sign</span>
          </div>
        </div>
      </div>
      <figcaption class="cap">{tabs[0].caption}</figcaption>
    </figure>

    <!-- --------------------------------------------- 2. the desktop app -->
    <figure class="panel">
      <div class="frame">
        <div class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="url plain">DocSigner</span>
        </div>
        <div class="body wide">
          <div class="app">
            <header class="topbar">
              <span class="brand">
                <span class="brand-mark" aria-hidden="true">
                  <Icon name="lucide:signature" />
                </span>
                DocSigner
              </span>
              <span class="spacer"></span>
              <span class="cta sm">Sign 12 PDFs</span>
            </header>

            <div class="toolbar">
              <span class="chip">Choose folder</span>
              <span class="path">~/Invoices/2026-04</span>
              <span class="count">12 PDFs</span>
            </div>

            <div class="work">
              <section class="queue">
                <p class="qhead label">12 of 12 <span class="qsum">3 signed</span></p>
                <div class="qrow sel">
                  <Icon name="lucide:file-text" aria-hidden="true" />
                  <span class="qmain">
                    <span class="qname">invoice_2026_0412.pdf</span>
                    <span class="qsub">12,698 KB</span>
                  </span>
                </div>
                <div class="qrow">
                  <Icon name="lucide:file-text" aria-hidden="true" />
                  <span class="qmain">
                    <span class="qname">invoice_2026_0413.pdf</span>
                    <span class="qsub">invoice_2026_0413_signed.pdf</span>
                  </span>
                  <Icon name="lucide:check" class="ok" aria-hidden="true" />
                </div>
                <div class="qrow">
                  <Icon name="lucide:file-text" aria-hidden="true" />
                  <span class="qmain">
                    <span class="qname">credit_note_0088.pdf</span>
                    <span class="qsub">credit_note_0088_signed.pdf</span>
                  </span>
                  <Icon name="lucide:check" class="ok" aria-hidden="true" />
                </div>
                <div class="qrow">
                  <Icon name="lucide:file-text" aria-hidden="true" />
                  <span class="qmain">
                    <span class="qname">annexure_c.pdf</span>
                    <span class="qsub">already signed</span>
                  </span>
                  <Icon name="lucide:minus" class="skip" aria-hidden="true" />
                </div>
              </section>

              <section class="stage">
                <div class="ctools">
                  <span class="page-ind">1 / 4</span>
                  <span class="zoom">100%</span>
                </div>
                <div class="cscroll">
                  <div class="sheet paper">
                    <span class="rule w1"></span><span class="rule"></span>
                    <span class="rule"></span><span class="rule w2"></span>
                    <span class="rule"></span><span class="rule w3"></span>
                    <span class="sigbox">Signed by Smit Vora</span>
                  </div>
                </div>
              </section>

              <aside class="setup">
                <div class="field">
                  <span class="flabel">Certificate</span>
                  <span class="control">Smit Vora (signing, ePass2003, valid until 2027-04-11)</span>
                </div>
                <div class="field">
                  <span class="flabel">Standard</span>
                  <span class="control">CCA-LTA</span>
                </div>
                <div class="field">
                  <span class="flabel">Save as</span>
                  <span class="control">Filename suffix <b>_signed</b></span>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="cap">{tabs[1].caption}</figcaption>
    </figure>

    <!-- ------------------------------------------------- 3. in ERPNext -->
    <figure class="panel">
      <div class="frame">
        <div class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="url">
            <Icon name="lucide:lock" aria-hidden="true" />
            erp.yourcompany.in/app/sales-invoice/ACC-SINV-2026-0412
          </span>
        </div>
        <div class="body wide">
          <div class="erp">
            <div class="erp-bar">
              <span class="erp-title">ACC-SINV-2026-0412</span>
              <span class="tag">Submitted</span>
              <span class="spacer"></span>
              <span class="chip">Print</span>
              <span class="cta sm">Sign</span>
            </div>
            <div class="erp-body">
              <div class="sheet paper tall">
                <span class="rule w1"></span><span class="rule"></span>
                <span class="rule w2"></span><span class="rule"></span>
                <span class="rule"></span><span class="rule w3"></span>
                <span class="rule"></span><span class="rule w2"></span>
                <span class="sigbox wide-box">
                  Digitally signed by SMIT VORA
                  <span class="qr" aria-hidden="true"></span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="cap">{tabs[2].caption}</figcaption>
    </figure>
  </div>
</div>

<style>
  .surfaces {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tablist {
    display: flex;
    gap: var(--s-1);
    flex-wrap: wrap;
    align-self: flex-start;
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--radius-sm);
    padding: var(--s-1);
  }

  label {
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--dim);
    padding: var(--s-2) var(--s-4);
    border-radius: var(--radius-card);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  label:hover {
    color: var(--text);
  }

  .panel {
    display: none;
    margin: 0;
    flex-direction: column;
    gap: var(--s-3);
  }

  input:nth-of-type(1):checked ~ .tablist label:nth-of-type(1),
  input:nth-of-type(2):checked ~ .tablist label:nth-of-type(2),
  input:nth-of-type(3):checked ~ .tablist label:nth-of-type(3) {
    background: var(--green-soft);
    color: var(--green-ink);
  }

  input:nth-of-type(1):focus-visible ~ .tablist label:nth-of-type(1),
  input:nth-of-type(2):focus-visible ~ .tablist label:nth-of-type(2),
  input:nth-of-type(3):focus-visible ~ .tablist label:nth-of-type(3) {
    box-shadow: var(--focus-ring);
  }

  input:nth-of-type(1):checked ~ .panels .panel:nth-of-type(1),
  input:nth-of-type(2):checked ~ .panels .panel:nth-of-type(2),
  input:nth-of-type(3):checked ~ .panels .panel:nth-of-type(3) {
    display: flex;
  }

  /* ---- the frame ---- */
  .frame {
    border: var(--hairline);
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 34px;
    padding-inline: var(--s-3);
    background: var(--surface);
    border-bottom: var(--hairline);
  }

  .dots {
    display: flex;
    gap: 6px;
    flex: none;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: var(--pill);
    background: var(--border-strong);
  }

  .url {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--faint);
    background: var(--well);
    border-radius: var(--pill);
    padding: 3px var(--s-3);
    overflow: hidden;
    white-space: nowrap;
    min-width: 0;
  }

  .url.plain {
    background: none;
    font-family: var(--font);
  }

  .url :global(svg) {
    width: var(--icon-xs);
    height: var(--icon-xs);
    color: var(--green-ink);
  }

  .body {
    background: var(--bg-deep);
  }

  /* The two surfaces that cannot reflow scroll sideways at full size instead of
     shrinking to fit. */
  .body.wide {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .cap {
    font-size: var(--text-sm);
    color: var(--faint);
  }

  /* ---- shared bits ---- */
  .cta {
    display: grid;
    place-items: center;
    height: var(--control-h-lg);
    border-radius: var(--radius-sm);
    background: var(--green);
    color: var(--on-accent);
    font-weight: var(--fw-semibold);
    font-size: var(--text-sm);
  }

  .cta.sm {
    height: var(--control-h-sm);
    padding-inline: var(--s-4);
    flex: none;
  }

  .chip {
    flex: none;
    display: inline-grid;
    place-items: center;
    height: var(--control-h-sm);
    padding-inline: var(--s-3);
    border: var(--hairline);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--dim);
  }

  .flabel {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--faint);
  }

  .control {
    display: block;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius-sm);
    background: var(--well);
    border: var(--hairline);
    font-size: var(--text-sm);
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .control.file {
    border-style: dashed;
    border-color: var(--border-strong);
    color: var(--dim);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .spacer {
    flex: 1;
  }

  /* ---- 1. web ---- */
  .web {
    max-width: 520px;
    margin-inline: auto;
    padding: var(--s-6) var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .card {
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--radius);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .card-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }

  .step {
    color: var(--action-ink);
    font-variant-numeric: tabular-nums;
  }

  .state {
    margin-left: auto;
    letter-spacing: 0;
    text-transform: none;
    color: var(--dim);
  }

  /* ---- 2. desktop app ---- */
  .app {
    /* Its real proportions. Narrower than this and it stops being the app. */
    min-width: 860px;
    background: var(--bg);
  }

  .topbar,
  .toolbar,
  .erp-bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-4);
    border-bottom: var(--hairline);
  }

  .topbar .brand {
    font-size: var(--text-body);
  }

  .topbar :global(.brand-mark) {
    width: var(--icon-lg);
    height: var(--icon-lg);
  }

  .path {
    flex: 1;
    min-width: 0;
    padding: var(--s-2) var(--s-3);
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--dim);
    font-family: var(--mono);
  }

  .count {
    flex: none;
    background: var(--action-soft);
    color: var(--action-ink);
    border-radius: var(--pill);
    padding: 2px var(--s-3);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
  }

  .work {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 230px;
    min-height: 380px;
  }

  .queue {
    border-right: var(--hairline);
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .qhead {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--s-2);
  }

  .qsum {
    text-transform: none;
    letter-spacing: 0;
    color: var(--dim);
  }

  .qrow {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2);
    border-radius: var(--radius-card);
    color: var(--faint);
  }

  .qrow.sel {
    background: var(--surface);
    box-shadow: inset 2px 0 0 var(--action);
  }

  .qmain {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .qname {
    font-size: var(--text-sm);
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .qsub {
    font-size: var(--text-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ok {
    color: var(--green-ink);
  }

  .skip {
    color: var(--amber-ink);
  }

  .stage {
    background: var(--bg-deep);
    display: flex;
    flex-direction: column;
  }

  .ctools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s-2) var(--s-4);
    border-bottom: var(--hairline);
    font-size: var(--text-sm);
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .cscroll {
    flex: 1;
    display: grid;
    place-items: start center;
    padding: var(--s-5);
  }

  .setup {
    border-left: var(--hairline);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .setup .control {
    font-size: var(--text-xs);
  }

  /* ---- the rendered page, in both app and erp ---- */
  .sheet {
    width: 260px;
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: 7px;
    position: relative;
  }

  .sheet.tall {
    width: 420px;
    gap: 9px;
  }

  .rule {
    height: 3px;
    border-radius: 2px;
    background: var(--paper-line);
  }

  .rule.w1 {
    width: 45%;
    height: 5px;
    background: var(--paper-ink);
    opacity: 0.55;
    margin-bottom: var(--s-2);
  }

  .rule.w2 {
    width: 78%;
  }

  .rule.w3 {
    width: 60%;
  }

  /* Off the type ladder on purpose. This is text inside a picture of a printed
     page, drawn at the page's scale: a real stamp is a few millimetres tall, and
     setting it at --text-xs would make it taller than the paragraph rules beside
     it. Nobody reads it, they recognise it. */
  .sigbox {
    margin-top: var(--s-4);
    border: 1px solid var(--paper-line);
    border-radius: 2px;
    padding: var(--s-2);
    font-size: 8px;
    color: var(--paper-ink);
    letter-spacing: 0.02em;
  }

  .sigbox.wide-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  /* The QR panel appearance.py draws when qr_url is set: square, full height. */
  .qr {
    flex: none;
    width: 30px;
    height: 30px;
    background:
      repeating-conic-gradient(var(--paper-ink) 0 25%, transparent 0 50%) 0 0 /
      6px 6px;
    opacity: 0.75;
  }

  /* ---- 3. erp ---- */
  .erp {
    min-width: 720px;
    background: var(--bg);
  }

  .erp-title {
    font-weight: var(--fw-semibold);
    font-size: var(--text-sm);
  }

  .tag {
    flex: none;
    background: var(--green-soft);
    color: var(--green-ink);
    border-radius: var(--pill);
    padding: 2px var(--s-2);
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
  }

  .erp-body {
    background: var(--bg-deep);
    display: grid;
    place-items: start center;
    padding: var(--s-6);
    min-height: 380px;
  }
</style>
