---
import { Icon } from 'astro-icon/components';

/*
 * Two surfaces, both signable. Press the button and the thing happens.
 *
 * Accuracy notes, all traced to source rather than to the older prototype:
 *
 * Desktop app (desktop/frontend/src)
 *   - "Sign 4 PDFs" is App.tsx:404's `Sign ${filesToSign.length} PDF(s)`.
 *   - Queue head is a checkbox plus `${included.size} of ${files.length}`
 *     (App.tsx:456); the summary joins with " · " (App.tsx:465).
 *   - A row's subtitle is its size in KB (App.tsx:499).
 *   - SetupPanel has five fields, Timestamp authority among them.
 *   - PIN copy is PinDialog's own.
 *   - The theme button is real, so here it really switches the site's theme.
 *
 * ERPNext (apps/docsigner_integration)
 *   - The button group is `__("Digitally Sign")` with "Print format…" and
 *     "Attachment…" (lib/form.js:35-48).
 *   - The signed headline is set by frm.dashboard.set_headline as
 *     `✓ Digitally signed by {CN} · Signed PDF · Verify` (lib/form.js:22-31).
 *   - Print Format gets "Set signature position" under a DocSigner group
 *     (print_format.js:7).
 *   - It is a SEPARATE app. The caption says so.
 *
 * The stamp is the product's own `image` style: a drawn mark plus the QR panel
 * appearance.py composes when qr_url is set. The QR is real -- generated by the
 * same qrcode settings appearance.py uses, and it resolves to resilient.tech.
 * Its size against the page is realistic: a DSC stamp box is roughly 180x60pt
 * on A4, which is about a third of the page width.
 */

const files = [
  { name: 'invoice_2026_0412.pdf', size: '12,698 KB', outcome: 'signed' },
  { name: 'invoice_2026_0413.pdf', size: '431 KB', outcome: 'signed' },
  { name: 'credit_note_0088.pdf', size: '96 KB', outcome: 'signed' },
  { name: 'annexure_c.pdf', size: '1,204 KB', outcome: 'skipped' },
];

const rows = [
  ['ERPNext implementation, Q1 2026', '1', '4,20,000.00'],
  ['India Compliance, annual licence', '1', '72,000.00'],
  ['Onboarding and data migration', '2', '48,000.00'],
];

const tabs = [
  { id: 'app', label: 'The desktop app' },
  { id: 'erp', label: 'Your own system' },
];
---

<div class="surfaces">
  {tabs.map((t, i) => (
    <input type="radio" name="surface" id={`s-${t.id}`} checked={i === 0} />
  ))}

  <div class="tablist" role="group" aria-label="Where signing happens">
    {tabs.map((t) => <label for={`s-${t.id}`}>{t.label}</label>)}
  </div>

  <div class="panels">
    <!-- ============================================= the desktop app -->
    <figure class="panel">
      <div class="frame" data-app>
        <div class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="win">DocSigner</span>
        </div>

        <div class="scroller">
          <div class="app">
            <header class="topbar">
              <span class="brand">
                <span class="brand-mark" aria-hidden="true"><Icon name="lucide:signature" /></span>
                DocSigner
              </span>
              <span class="spacer"></span>
              <!-- The app has this button, so it works. It switches the site. -->
              <button type="button" class="ic" data-app-theme title="Switch theme">
                <Icon name="lucide:sun" class="sun" aria-hidden="true" />
                <Icon name="lucide:moon" class="moon" aria-hidden="true" />
                <span class="sr-only">Switch theme</span>
              </button>
              <button type="button" class="btn primary" data-sign-app>
                <span data-sign-label>Sign 4 PDFs</span>
              </button>
            </header>

            <div class="toolbar">
              <span class="btn ghost"><Icon name="lucide:folder-open" aria-hidden="true" /> Choose folder</span>
              <span class="path">~/Invoices/2026-04</span>
              <span class="ic flat" aria-hidden="true"><Icon name="lucide:refresh-cw" /></span>
            </div>

            <div class="work">
              <section class="queue">
                <div class="qhead">
                  <span class="qall"><span class="box on" aria-hidden="true"></span> 4 of 4</span>
                  <span class="qsum" data-summary hidden>3 signed · 1 skipped</span>
                </div>
                {files.map((f, i) => (
                  <div class={`qrow${i === 0 ? ' sel' : ''}`} data-row={i} data-outcome={f.outcome}>
                    <span class="box on" aria-hidden="true"></span>
                    <Icon name="lucide:file-text" class="fic" aria-hidden="true" />
                    <span class="qmain">
                      <span class="qname">{f.name}</span>
                      <span class="qsub">{f.size}</span>
                    </span>
                    <span class="qstatus" aria-hidden="true">
                      <Icon name="lucide:circle-check" class="ok" />
                      <Icon name="lucide:circle-minus" class="skip" />
                    </span>
                  </div>
                ))}
              </section>

              <section class="stage">
                <div class="ctools">
                  <span class="pager">
                    <Icon name="lucide:chevron-left" aria-hidden="true" /> 1 / 4
                    <Icon name="lucide:chevron-right" aria-hidden="true" />
                  </span>
                  <span class="zoom">100%</span>
                </div>
                <div class="cscroll">
                  <div class="doc paper">
                    <div class="lh">
                      <span class="lh-mark" aria-hidden="true"></span>
                      <span class="lh-txt">
                        <b>Resilient Software Services LLP</b>
                        <i>Ahmedabad · GSTIN 24AAWFR1234K1ZP</i>
                      </span>
                    </div>
                    <p class="d-kind">Tax Invoice</p>
                    <div class="d-rules">
                      <span class="r w1"></span><span class="r"></span><span class="r w2"></span>
                      <span class="r"></span><span class="r w3"></span>
                    </div>
                    <div class="d-tbl">
                      <span class="tr th"></span>
                      <span class="tr"></span><span class="tr"></span><span class="tr"></span>
                      <span class="tr tot"></span>
                    </div>
                    <div class="d-foot">
                      <span class="stamp" data-stamp>
                        <span class="stamp-mark" aria-hidden="true">
                          <svg viewBox="0 0 120 44" aria-hidden="true">
                            <path d="M8 30c11-3 16-19 22-21s8 10 3 16-11 4-8-2 12-11 21-11 13 8 22 6 12-10 19-10"
                              fill="none" stroke="currentColor" stroke-width="2.4"
                              stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                        <span class="stamp-txt">
                          <b>Signed by Smit Vora</b>
                          <em>2026-04-11 14:32 +05:30</em>
                        </span>
                        <img class="stamp-qr" src="/qr-resilient.svg" alt="" width="44" height="44" />
                      </span>
                    </div>
                  </div>
                </div>
              </section>

              <aside class="setup">
                <div class="f"><span class="fl">Certificate</span><span class="c">Smit Vora (signing, ePass2003, valid until 2027-04-11)</span></div>
                <div class="f"><span class="fl">Signature</span>
                  <span class="c mini paper">
                    <svg viewBox="0 0 120 40" aria-hidden="true">
                      <path d="M8 28c11-3 16-18 22-20s8 10 3 15-11 4-8-2 12-10 21-10 13 8 22 6 12-9 19-9"
                        fill="none" stroke="currentColor" stroke-width="2.6"
                        stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
                <div class="f"><span class="fl">Standard</span><span class="c">CCA-LTA</span></div>
                <div class="f"><span class="fl">Timestamp authority</span><span class="c">DigiCert</span></div>
                <div class="f"><span class="fl">Save as</span><span class="c">Filename suffix <b>_signed</b></span></div>
              </aside>
            </div>
          </div>

          <div class="pinwrap" data-pin hidden>
            <div class="pin">
              <p class="pin-t">Enter token PIN</p>
              <p class="pin-s">One PIN signs every file.</p>
              <span class="pin-in">••••••</span>
              <div class="pin-btns">
                <span class="btn ghost">Cancel</span>
                <button type="button" class="btn primary" data-pin-ok>Sign</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="cap">The desktop app, signing a folder. Press the button.</figcaption>
    </figure>

    <!-- ============================= an integration, on ERPNext -->
    <figure class="panel">
      <div class="frame" data-erp>
        <div class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="url">
            <Icon name="lucide:lock" aria-hidden="true" />
            erp.resilient.tech/app/sales-invoice/ACC-SINV-2026-0412
          </span>
        </div>

        <div class="scroller">
          <div class="erp">
            <div class="erp-head">
              <span class="crumb">Sales Invoice</span>
              <span class="erp-id">ACC-SINV-2026-0412</span>
              <span class="pill" data-pill>Submitted</span>
              <span class="spacer"></span>
              <span class="btn ghost">Print</span>
              <button type="button" class="btn primary group" data-sign-erp>
                <span data-erp-label>Digitally Sign</span>
                <Icon name="lucide:chevron-down" aria-hidden="true" />
              </button>
            </div>

            <!-- frm.dashboard.set_headline, once a signature exists -->
            <div class="headline" data-headline hidden>
              <Icon name="lucide:check" aria-hidden="true" />
              Digitally signed by SMIT VORA ·
              <a href="/qr-resilient.svg" rel="noopener">Signed PDF</a> ·
              <a href="https://resilient.tech" rel="noopener">Verify</a>
            </div>

            <div class="erp-body">
              <div class="invoice paper">
                <header class="inv-head">
                  <div class="inv-co">
                    <span class="lh-mark big" aria-hidden="true"></span>
                    <div>
                      <p class="co">Resilient Software Services LLP</p>
                      <p class="co-sub">4th Floor, Prahladnagar, Ahmedabad 380015, Gujarat</p>
                      <p class="co-sub">GSTIN 24AAWFR1234K1ZP · LLPIN AAW-1234</p>
                    </div>
                  </div>
                  <p class="inv-kind">Tax Invoice</p>
                </header>

                <div class="inv-meta">
                  <span><i>Invoice</i> ACC-SINV-2026-0412</span>
                  <span><i>Date</i> 11 Apr 2026</span>
                  <span><i>Terms</i> Net 30</span>
                </div>

                <div class="inv-to">
                  <p class="to-l">Billed to</p>
                  <p class="to-n">Northwind Traders Pvt Ltd</p>
                  <p class="to-a">Andheri East, Mumbai 400069 · GSTIN 27AABCN1234M1Z8</p>
                </div>

                <table class="inv-tbl">
                  <thead>
                    <tr><th>Description</th><th class="num">Qty</th><th class="num">Amount ₹</th></tr>
                  </thead>
                  <tbody>
                    {rows.map(([d, q, a]) => (
                      <tr><td>{d}</td><td class="num">{q}</td><td class="num">{a}</td></tr>
                    ))}
                  </tbody>
                  <tfoot>
                    <tr><td colspan="2">Subtotal</td><td class="num">5,40,000.00</td></tr>
                    <tr><td colspan="2">IGST 18%</td><td class="num">97,200.00</td></tr>
                    <tr class="tot"><td colspan="2">Total</td><td class="num">6,37,200.00</td></tr>
                  </tfoot>
                </table>

                <div class="inv-foot">
                  <p class="terms">
                    Payable within 30 days. Interest at 18% p.a. thereafter.
                    Subject to Ahmedabad jurisdiction.
                  </p>
                  <span class="stamp" data-stamp>
                    <span class="stamp-mark" aria-hidden="true">
                      <svg viewBox="0 0 120 44" aria-hidden="true">
                        <path d="M8 30c11-3 16-19 22-21s8 10 3 16-11 4-8-2 12-11 21-11 13 8 22 6 12-10 19-10"
                          fill="none" stroke="currentColor" stroke-width="2.4"
                          stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="stamp-txt">
                      <b>Digitally signed by SMIT VORA</b>
                      <em>2026-04-11 14:32 +05:30</em>
                      <i>Scan to verify</i>
                    </span>
                    <img class="stamp-qr" src="/qr-resilient.svg" alt="" width="52" height="52" />
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="cap">
        ERPNext, signing an invoice on submit. Built with
        <a href="https://github.com/resilient-tech/docsigner/blob/HEAD/docs/roadmap.md" rel="noopener">docsigner_integration</a>,
        a separate app. Yours could look like anything.
      </figcaption>
    </figure>
  </div>
</div>

<script>
  import { isPaper, toggleTheme } from '../lib/theme';

  const app = document.querySelector<HTMLElement>('[data-app]');
  const erp = document.querySelector<HTMLElement>('[data-erp]');

  if (app) {
    const pin = app.querySelector<HTMLElement>('[data-pin]');
    const label = app.querySelector<HTMLElement>('[data-sign-label]');
    const summary = app.querySelector<HTMLElement>('[data-summary]');

    const reset = () => {
      app.classList.remove('signing', 'done');
      if (pin) pin.hidden = true;
      if (summary) summary.hidden = true;
      if (label) label.textContent = 'Sign 4 PDFs';
    };

    app.querySelector('[data-sign-app]')?.addEventListener('click', () => {
      if (app.classList.contains('done')) return reset();
      if (pin) pin.hidden = false;
    });

    app.querySelector('[data-pin-ok]')?.addEventListener('click', () => {
      if (pin) pin.hidden = true;
      app.classList.add('signing');
      if (label) label.textContent = 'Signing…';
      setTimeout(() => {
        app.classList.add('done');
        if (summary) summary.hidden = false;
        if (label) label.textContent = 'Sign again';
      }, 1500);
    });

    /* The app's own theme button, doing the app's own job. */
    const themeBtn = app.querySelector<HTMLButtonElement>('[data-app-theme]');
    const syncTheme = () =>
      themeBtn?.setAttribute('title', `Switch to ${isPaper() ? 'dark' : 'paper'} theme`);
    themeBtn?.addEventListener('click', toggleTheme);
    document.addEventListener('themechange', syncTheme);
    syncTheme();
  }

  if (erp) {
    const label = erp.querySelector<HTMLElement>('[data-erp-label]');
    const pill = erp.querySelector<HTMLElement>('[data-pill]');
    const headline = erp.querySelector<HTMLElement>('[data-headline]');

    erp.querySelector('[data-sign-erp]')?.addEventListener('click', () => {
      const done = erp.classList.toggle('done');
      if (label) label.textContent = done ? 'Signed' : 'Digitally Sign';
      if (pill) pill.textContent = done ? 'Signed' : 'Submitted';
      pill?.classList.toggle('good', done);
      if (headline) headline.hidden = !done;
    });
  }
</script>

<style>
  .surfaces { display: flex; flex-direction: column; gap: var(--s-5); }
  input { position: absolute; opacity: 0; pointer-events: none; }

  .tablist {
    display: flex; gap: var(--s-1); flex-wrap: wrap; align-self: flex-start;
    background: var(--surface); border: var(--hairline);
    border-radius: var(--radius-sm); padding: var(--s-1);
  }
  label {
    font-size: var(--text-sm); font-weight: var(--fw-medium); color: var(--dim);
    padding: var(--s-2) var(--s-4); border-radius: var(--radius-card); cursor: pointer;
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  label:hover { color: var(--text); }
  .panel { display: none; margin: 0; flex-direction: column; gap: var(--s-3); }

  input:nth-of-type(1):checked ~ .tablist label:nth-of-type(1),
  input:nth-of-type(2):checked ~ .tablist label:nth-of-type(2) {
    background: var(--green-soft); color: var(--green-ink);
  }
  input:nth-of-type(1):focus-visible ~ .tablist label:nth-of-type(1),
  input:nth-of-type(2):focus-visible ~ .tablist label:nth-of-type(2) { box-shadow: var(--focus-ring); }
  input:nth-of-type(1):checked ~ .panels .panel:nth-of-type(1),
  input:nth-of-type(2):checked ~ .panels .panel:nth-of-type(2) { display: flex; }

  /* ---- frame ---- */
  .frame {
    position: relative; border: var(--hairline); border-radius: var(--radius);
    background: var(--bg); overflow: hidden; box-shadow: var(--shadow-lift);
  }
  .bar {
    display: flex; align-items: center; gap: var(--s-3); height: 34px;
    padding-inline: var(--s-3); background: var(--surface); border-bottom: var(--hairline);
  }
  .dots { display: flex; gap: 6px; flex: none; }
  .dots i { width: 9px; height: 9px; border-radius: var(--pill); background: var(--border-strong); }
  .win { font-size: var(--text-sm); color: var(--faint); }
  .url {
    display: inline-flex; align-items: center; gap: 6px; min-width: 0;
    font-family: var(--mono); font-size: var(--text-xs); color: var(--faint);
    background: var(--well); border-radius: var(--pill); padding: 3px var(--s-3);
    overflow: hidden; white-space: nowrap;
  }
  .url :global(svg) { width: var(--icon-xs); height: var(--icon-xs); color: var(--green-ink); }
  .scroller { overflow-x: auto; overscroll-behavior-x: contain; position: relative; }
  .cap { font-size: var(--text-sm); color: var(--faint); max-width: var(--measure); }
  .cap a { color: var(--action-ink); }

  /* ---- controls ---- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--s-2);
    flex: none; height: var(--control-h-sm); padding-inline: var(--s-4);
    border: 1px solid transparent; border-radius: var(--radius-sm);
    font-size: var(--text-sm); font-weight: var(--fw-semibold); white-space: nowrap;
    transition: background var(--dur-fast) var(--ease);
  }
  .btn.primary { background: var(--green); color: var(--on-accent); cursor: pointer; }
  .btn.primary:hover { background: var(--green-hover); }
  .btn.ghost { border: var(--hairline); color: var(--dim); }
  .btn :global(svg) { width: var(--icon-xs); height: var(--icon-xs); }
  .ic {
    display: grid; place-items: center; width: 26px; height: 26px;
    border-radius: var(--radius-card); color: var(--faint); cursor: pointer;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .ic:hover { background: var(--hover); color: var(--text); }
  .ic.flat { cursor: default; }
  .ic :global(svg) { grid-area: 1 / 1; }
  .ic :global(.moon) { display: none; }
  :global(:root[data-theme='paper']) .ic :global(.moon) { display: block; }
  :global(:root[data-theme='paper']) .ic :global(.sun) { display: none; }
  .spacer { flex: 1; }

  .fl {
    font-size: var(--text-xs); font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--faint);
  }
  .c {
    display: block; padding: var(--s-2) var(--s-3); border-radius: var(--radius-sm);
    background: var(--well); border: var(--hairline); font-size: var(--text-xs);
    color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .f { display: flex; flex-direction: column; gap: var(--s-1); }
  .box { flex: none; width: 13px; height: 13px; border-radius: 3px; border: 1px solid var(--border-strong); }
  .box.on { background: var(--green); border-color: var(--green); }

  /* ---- desktop app ---- */
  .app { min-width: 920px; }
  .topbar, .toolbar {
    display: flex; align-items: center; gap: var(--s-3);
    padding: var(--s-2) var(--s-4); border-bottom: var(--hairline);
  }
  .topbar .brand { font-size: var(--text-body); }
  .topbar :global(.brand-mark) { width: var(--icon-lg); height: var(--icon-lg); }
  .path {
    flex: 1; min-width: 0; padding: var(--s-2) var(--s-3);
    background: var(--surface); border: var(--hairline); border-radius: var(--radius-sm);
    font-size: var(--text-sm); color: var(--dim); font-family: var(--mono);
  }
  .work { display: grid; grid-template-columns: 262px minmax(0, 1fr) 236px; min-height: 452px; }

  .queue { border-right: var(--hairline); padding: var(--s-3); display: flex; flex-direction: column; gap: 2px; }
  .qhead {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--s-2); font-size: var(--text-sm); color: var(--dim);
  }
  .qall { display: inline-flex; align-items: center; gap: var(--s-2); }
  .qsum { color: var(--green-ink); font-weight: var(--fw-semibold); }
  .qrow {
    display: flex; align-items: center; gap: var(--s-2);
    padding: var(--s-2); border-radius: var(--radius-card); color: var(--faint);
  }
  .qrow.sel { background: var(--surface); box-shadow: inset 2px 0 0 var(--action); }
  .fic { color: var(--faint); }
  .qmain { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .qname { font-size: var(--text-sm); color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .qsub { font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .qstatus { flex: none; display: grid; place-items: center; width: 16px; height: 16px; }
  .qstatus :global(svg) {
    grid-area: 1 / 1; opacity: 0; transform: scale(.6);
    transition: opacity .18s var(--ease), transform .18s var(--ease);
  }
  .qstatus :global(.ok) { color: var(--green-ink); }
  .qstatus :global(.skip) { color: var(--amber-ink); }
  .signing [data-row='0'] .qstatus :global(svg) { transition-delay: .1s; }
  .signing [data-row='1'] .qstatus :global(svg) { transition-delay: .36s; }
  .signing [data-row='2'] .qstatus :global(svg) { transition-delay: .62s; }
  .signing [data-row='3'] .qstatus :global(svg) { transition-delay: .88s; }
  .signing [data-outcome='signed'] .qstatus :global(.ok),
  .signing [data-outcome='skipped'] .qstatus :global(.skip) { opacity: 1; transform: none; }

  .stage { background: var(--bg-deep); display: flex; flex-direction: column; }
  .ctools {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--s-2) var(--s-4); border-bottom: var(--hairline);
    font-size: var(--text-sm); color: var(--dim); font-variant-numeric: tabular-nums;
  }
  .pager { display: inline-flex; align-items: center; gap: var(--s-2); }
  .cscroll { flex: 1; display: grid; place-items: start center; padding: var(--s-5); }
  .setup { border-left: var(--hairline); padding: var(--s-4); display: flex; flex-direction: column; gap: var(--s-4); }

  /* ---- the rendered page in the canvas ---- */
  /* Bigger than before: it is the thing being signed, so it should read as a
     page rather than a thumbnail. */
  .doc {
    width: 320px; padding: 18px 20px 20px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .lh { display: flex; align-items: center; gap: 7px; padding-bottom: 8px; border-bottom: 1px solid var(--paper-line); }
