---
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';
import { formatSize, type Artifact } from '../lib/release';

interface Props {
  title: string;
  blurb: string;
  icon: string;
  version: string;
  artifact?: Artifact;
  /* Shell one-liner. Shown under the button when there is one (Homebrew is an
     alternative to the zip, not a separate product), and alone when there is
     not. */
  command?: string;
  /* Marks the card the visitor's platform detection lit up. Set client-side. */
  os?: string;
}

const { title, blurb, icon, version, artifact, command, os } = Astro.props;
const size = formatSize(artifact?.size ?? null);

/*
 * The trust block. Publishing size, hash and a verify command next to the button
 * is the thing a signing tool of all things should not be omitting, and it costs
 * nothing: the release already writes SHA256SUMS.
 *
 * It is folded now. Version and size sit on one line under the button, and the
 * filename, the hash and the command that checks it live behind one summary.
 * Nine cards printing a 64-character hash in full was the loudest thing on the
 * page, and the people who check a hash are the people who will open a fold.
 *
 * Attestations are not wired into CI yet (roadmap D7), so no `gh attestation
 * verify` line is offered. Claiming one that doesn't exist would be worse than
 * having none.
 */
const verify = artifact?.sha256
  ? `shasum -a 256 ${artifact.filename}\n# expect ${artifact.sha256}`
  : null;
---

<article class="dl" data-os={os}>
  <header>
    <Icon name={icon} aria-hidden="true" />
    <div>
      <h3>
        {title}
        <!-- The green edge alone would make colour the only carrier of "this is
             yours". CSS reveals this from the same data-match attribute, so the
             script still sets one thing. -->
        <span class="match">Your platform</span>
      </h3>
      <p class="blurb">{blurb}</p>
    </div>
  </header>

  {
    artifact ? (
      <>
        <Button href={artifact.url} variant="primary" size="md" icon="lucide:download">
          Download
        </Button>
        {command && <code class="cmd">{command}</code>}
        <p class="meta">
          {version}
          {size && ` · ${size}`}
        </p>
        {verify && (
          <details>
            <summary>Verify this download</summary>
            <dl class="facts">
              <div>
                <dt class="label">File</dt>
                <dd class="mono">{artifact.filename}</dd>
              </div>
              <div>
                <dt class="label">SHA-256</dt>
                <dd class="mono hash">{artifact.sha256}</dd>
              </div>
            </dl>
            <pre>{verify}</pre>
          </details>
        )}
      </>
    ) : command ? (
      <code class="cmd">{command}</code>
    ) : (
      <p class="pending">Not in this release.</p>
    )
  }
</article>

<style>
  /* Card: --surface, one hairline, --radius, --s-6, and no shadow in either
     theme. A thing that needs a shadow is a menu or a modal. */
  .dl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--radius);
    padding: var(--s-5);
  }

  /* Selected: one edge. This used to be a border colour plus a 1px ring
     drawing the same line twice. */
  .dl[data-match='true'] {
    border-color: var(--green);
  }

  /* Chip: pill, hairline, --text-xs semibold, and the active tone's ink on its
     own tint. */
  .match {
    display: none;
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    color: var(--green-ink);
    background: var(--green-soft);
    border: 1px solid var(--green);
    border-radius: var(--pill);
    padding: 1px var(--s-2);
    margin-left: var(--s-2);
    white-space: nowrap;
    vertical-align: middle;
  }

  .dl[data-match='true'] .match {
    display: inline-block;
  }

  header {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
  }

  header :global(svg) {
    width: var(--icon-md);
    height: var(--icon-md);
    color: var(--green-ink);
    margin-top: 2px;
  }

  h3 {
    font-size: var(--display-3);
    letter-spacing: 0;
  }

  .blurb {
    color: var(--dim);
    font-size: var(--text-body);
    margin-top: var(--s-1);
  }

  /* Version and size, the two facts worth seeing without asking. */
  .meta {
    font-size: var(--text-xs);
    color: var(--dim);
  }

  .facts {
    display: grid;
    gap: var(--s-3);
    width: 100%;
    margin: var(--s-3) 0 0;
    font-size: var(--text-xs);
  }

  dd {
    margin: var(--s-1) 0 0;
    color: var(--dim);
  }

  .mono {
    font-family: var(--mono);
  }

  /* A 64-char hash has no break points, so give it one. */
  .hash {
    overflow-wrap: anywhere;
    line-height: 1.5;
  }

  .cmd {
    font-family: var(--mono);
    font-size: var(--text-sm);
    background: var(--well);
    border: var(--hairline);
    border-radius: var(--radius-card);
    padding: var(--s-2) var(--s-3);
    width: 100%;
    /* design/base.css sets inline code to nowrap; a tap path is long enough to
       need the opposite. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .pending {
    font-size: var(--text-sm);
    color: var(--faint);
  }

  details {
    width: 100%;
    font-size: var(--text-sm);
  }

  summary {
    cursor: pointer;
    color: var(--dim);
  }

  summary:hover {
    color: var(--text);
  }

  pre {
    margin-top: var(--s-2);
    padding: var(--s-3);
    background: var(--well);
    border: var(--hairline);
    border-radius: var(--radius-card);
    font-size: var(--text-xs);
    line-height: 1.6;
    overflow-x: auto;
    color: var(--dim);
  }
</style>
