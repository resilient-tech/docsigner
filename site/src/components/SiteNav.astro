---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import { links, REPO_PUBLIC, ready } from '../config';

const nav = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/standards', label: 'Standards' },
  { href: '/verify', label: 'Verify a PDF' },
  { href: '/download', label: 'Download' },
].filter((l) => ready(l.href));

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!-- No Download button here. It was the same action as the hero's, twice on one
     screen, and the right-hand slot is better spent on the source. -->
<header class="nav" data-nav>
  <div class="wrap inner">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <Icon name="lucide:signature" />
      </span>
      DocSigner
    </a>

    <nav class="links" aria-label="Main">
      {
        nav.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="right">
      {
        REPO_PUBLIC && (
          <a class="gh" href={links.repo} rel="noopener" aria-label="Source on GitHub">
            <Icon name="lucide:github" aria-hidden="true" />
          </a>
        )
      }
      <ThemeToggle />
    </div>

    <input type="checkbox" id="menu" aria-label="Menu" />
    <label for="menu" class="burger">
      <Icon name="lucide:menu" class="open" aria-hidden="true" />
      <Icon name="lucide:x" class="close" aria-hidden="true" />
    </label>

    <div class="sheet">
      {
        nav.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      {
        REPO_PUBLIC && (
          <a href={links.repo} rel="noopener">
            Source on GitHub
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  /* The nav sits on the hero with no edge, and grows one only once it is
     covering something. 12 lines instead of a border that is always there. */
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const sync = () => nav?.toggleAttribute('data-scrolled', window.scrollY > 8);
  addEventListener('scroll', sync, { passive: true });
  sync();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    /* Transparent and edgeless on the first screen. */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  /* Once it is over content, it earns its edge. */
  .nav[data-scrolled] {
    background: color-mix(in srgb, var(--bg) var(--nav-veil), transparent);
    backdrop-filter: blur(var(--nav-blur));
    border-bottom-color: var(--border);
    box-shadow: var(--shadow-card);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: var(--nav-h);
  }

  .brand {
    color: var(--text);
    text-decoration: none;
    flex: none;
  }

  .brand :global(.brand-mark) {
    width: var(--icon-lg);
    height: var(--icon-lg);
  }

  /* Centred, and genuinely centred: the brand and the right-hand group are the
     same kind of flex item, so the links sit in the middle of the bar rather
     than in the middle of what is left over. */
  .links {
    display: flex;
    justify-content: center;
    gap: var(--s-6);
    flex: 1;
  }

  .links a {
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--dim);
    text-decoration: none;
    padding-block: var(--s-2);
  }

  .links a:hover {
    color: var(--text);
  }

  .links a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 calc(-1 * var(--underline-w)) 0 var(--green);
  }

  .right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2);
    /* Matches .brand's rendered width closely enough that the centred links
       read as centred. */
    flex: none;
    min-width: 120px;
  }

  .gh {
    display: grid;
    place-items: center;
    width: var(--control-sq);
    height: var(--control-sq);
    color: var(--dim);
  }

  .gh:hover {
    color: var(--text);
  }

  /* ---- Mobile ---- */
  /* Checkbox drives the sheet, so the menu costs no JavaScript. */
  #menu,
  .burger,
  .sheet {
    display: none;
  }

  /* --bp-md. Centred links do not fit beside a wordmark on a phone, and the
     previous version simply hid them, which left three destinations with no
     route at all. */
  @media (max-width: 768px) {
    .links {
      display: none;
    }

    .right {
      min-width: 0;
      margin-left: auto;
    }

    .burger {
      display: grid;
      place-items: center;
      width: var(--control-h-md);
      height: var(--control-h-md);
      color: var(--dim);
      cursor: pointer;
      border: var(--hairline);
      border-radius: var(--radius-sm);
    }

    .burger :global(svg) {
      grid-area: 1 / 1;
    }

    .burger .close,
    #menu:checked ~ .burger .open {
      display: none;
    }

    #menu:checked ~ .burger .close {
      display: block;
    }

    #menu:focus-visible ~ .burger {
      box-shadow: var(--focus-ring);
    }

    #menu:checked ~ .sheet {
      display: flex;
    }

    .sheet {
      position: absolute;
      left: 0;
      right: 0;
      top: var(--nav-h);
      flex-direction: column;
      gap: var(--s-1);
      background: var(--bg);
      border-block: var(--hairline);
      box-shadow: var(--shadow-menu);
      padding: var(--s-4) var(--s-4) var(--s-6);
    }

    .sheet a {
      color: var(--text);
      text-decoration: none;
      font-weight: var(--fw-medium);
      padding: var(--s-3);
      border-radius: var(--radius-sm);
    }

    .sheet a:hover {
      background: var(--hover);
    }

    .sheet a[aria-current='page'] {
      box-shadow: inset var(--accent-bar) 0 0 var(--green);
    }
  }
</style>
