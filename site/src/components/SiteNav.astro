---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import Button from './Button.astro';
import { links, REPO_PUBLIC, ready } from '../config';

const nav = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/standards', label: 'Standards' },
  { href: '/verify', label: 'Verify a PDF' },
  { href: '/download', label: 'Download' },
].filter((l) => ready(l.href));

/* The CTA follows whatever is built. /setup is the real destination once phase 2
   lands; until then the download page is the honest next step. */
const cta = ready('/setup')
  ? { href: '/setup', label: 'Set up' }
  : { href: '/download', label: 'Download' };

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <div class="wrap inner">
    <!-- .brand and .brand-mark come from design/base.css: the gradient tile is
         the logo, drawn rather than fetched, so it takes the theme's tokens. -->
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <Icon name="lucide:signature" />
      </span>
      DocSigner
    </a>

    <nav class="links" aria-label="Main">
      {
        nav.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="right">
      <ThemeToggle />
      {
        REPO_PUBLIC && (
          <a class="gh" href={links.repo} rel="noopener" aria-label="Source on GitHub">
            <Icon name="lucide:github" aria-hidden="true" />
          </a>
        )
      }
      <Button href={cta.href} variant="primary" size="sm" class="cta">{cta.label}</Button>
    </div>

    <input type="checkbox" id="menu" aria-label="Menu" />
    <label for="menu" class="burger">
      <Icon name="lucide:menu" class="open" aria-hidden="true" />
      <Icon name="lucide:x" class="close" aria-hidden="true" />
    </label>

    <div class="sheet">
      {
        nav.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={cta.href} class="sheet-cta">{cta.label}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--bg) var(--nav-veil), transparent);
    backdrop-filter: blur(var(--nav-blur));
    border-bottom: var(--hairline);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: var(--s-8);
    height: var(--nav-h);
  }

  .brand {
    color: var(--text);
    text-decoration: none;
    flex: none;
  }

  /* The lockup is 28px in base.css; the nav wants it a shade smaller. */
  .brand :global(.brand-mark) {
    width: var(--icon-lg);
    height: var(--icon-lg);
  }

  .links {
    display: flex;
    gap: var(--s-6);
    margin-right: auto;
  }

  .links a {
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--dim);
    text-decoration: none;
    padding-block: var(--s-2);
  }

  .links a:hover {
    color: var(--text);
  }

  /* aria-current carries this for assistive tech and the text colour shifts
     too, so the rule is reinforcement rather than the only signal. */
  .links a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 calc(-1 * var(--underline-w)) 0 var(--green);
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
  }

  .gh {
    display: grid;
    place-items: center;
    width: var(--control-sq);
    height: var(--control-sq);
    color: var(--dim);
  }

  .gh:hover {
    color: var(--text);
  }

  /* ---- Mobile ---- */
  /* Checkbox drives the sheet, so the menu costs no JavaScript. */
  #menu,
  .burger,
  .sheet {
    display: none;
  }

  /* --bp-md. @media cannot read a custom property, so the number is typed;
     the token is where it is written down. */
  @media (max-width: 768px) {
    .links,
    .right {
      display: none;
    }

    .burger {
      display: grid;
      place-items: center;
      width: var(--control-h-md);
      height: var(--control-h-md);
      margin-left: auto;
      color: var(--dim);
      cursor: pointer;
      border: var(--hairline);
      border-radius: var(--radius-sm);
    }

    .burger :global(svg) {
      grid-area: 1 / 1;
    }

    .burger .close,
    #menu:checked ~ .burger .open {
      display: none;
    }

    #menu:checked ~ .burger .close {
      display: block;
    }

    #menu:focus-visible ~ .burger {
      box-shadow: var(--focus-ring);
    }

    #menu:checked ~ .sheet {
      display: flex;
    }

    .sheet {
      position: absolute;
      left: 0;
      right: 0;
      top: var(--nav-h);
      flex-direction: column;
      gap: var(--s-1);
      background: var(--bg);
      border-bottom: var(--hairline);
      padding: var(--s-4) var(--s-4) var(--s-6);
    }

    .sheet a {
      color: var(--text);
      text-decoration: none;
      font-weight: var(--fw-medium);
      padding: var(--s-3);
      border-radius: var(--radius-sm);
    }

    .sheet a:hover {
      background: var(--hover);
    }

    .sheet a[aria-current='page'] {
      box-shadow: inset var(--accent-bar) 0 0 var(--green);
    }

    .sheet-cta {
      background: var(--green);
      color: var(--on-accent);
      text-align: center;
      margin-top: var(--s-2);
      font-weight: var(--fw-semibold);
    }
  }
</style>
