---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import Button from './Button.astro';
import { links, REPO_PUBLIC, ready } from '../config';

const nav = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/standards', label: 'Standards' },
  { href: '/verify', label: 'Verify a PDF' },
  { href: '/download', label: 'Download' },
].filter((l) => ready(l.href));

/* The CTA follows whatever is built. /setup is the real destination once phase 2
   lands; until then the download page is the honest next step. */
const cta = ready('/setup')
  ? { href: '/setup', label: 'Set up' }
  : { href: '/download', label: 'Download' };

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <div class="wrap inner">
    <a href="/" class="brand">
      <img src="/favicon.svg" alt="" width="24" height="24" />
      <span>DocSigner</span>
    </a>

    <nav class="links" aria-label="Main">
      {
        nav.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="right">
      <ThemeToggle />
      {
        REPO_PUBLIC && (
          <a class="gh" href={links.repo} rel="noopener" aria-label="Source on GitHub">
            <Icon name="lucide:github" aria-hidden="true" />
          </a>
        )
      }
      <Button href={cta.href} variant="primary" size="md" class="cta">{cta.label}</Button>
    </div>

    <input type="checkbox" id="menu" aria-label="Menu" />
    <label for="menu" class="burger">
      <Icon name="lucide:menu" class="open" aria-hidden="true" />
      <Icon name="lucide:x" class="close" aria-hidden="true" />
    </label>

    <div class="sheet">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={cta.href} class="sheet-cta">{cta.label}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: var(--s-8);
    height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: var(--fw-semibold);
    color: var(--text);
    text-decoration: none;
    flex: none;
  }

  .links {
    display: flex;
    gap: var(--s-6);
    margin-right: auto;
  }

  .links a {
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--dim);
    text-decoration: none;
    padding-block: var(--s-2);
  }

  .links a:hover {
    color: var(--text);
  }

  /* aria-current carries this for assistive tech and the text colour shifts too,
     so the underline is reinforcement rather than the only signal. -ink so it
     clears 3:1 in light. */
  .links a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--green-ink);
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
  }

  .gh {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    color: var(--dim);
  }

  .gh:hover {
    color: var(--text);
  }

  .gh :global(svg) {
    width: 18px;
    height: 18px;
  }

  /* ---- Mobile ---- */
  /* Checkbox drives the sheet, so the menu costs no JavaScript. */
  #menu,
  .burger,
  .sheet {
    display: none;
  }

  @media (max-width: 860px) {
    .links,
    .right {
      display: none;
    }

    .burger {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      margin-left: auto;
      color: var(--dim);
      cursor: pointer;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
    }

    .burger :global(svg) {
      grid-area: 1 / 1;
      width: 18px;
      height: 18px;
    }

    .burger .close,
    #menu:checked ~ .burger .open {
      display: none;
    }

    #menu:checked ~ .burger .close {
      display: block;
    }

    #menu:focus-visible ~ .burger {
      outline: 2px solid var(--action);
      outline-offset: 2px;
    }

    #menu:checked ~ .sheet {
      display: flex;
    }

    .sheet {
      position: absolute;
      left: 0;
      right: 0;
      top: 60px;
      flex-direction: column;
      gap: var(--s-1);
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: var(--s-4) var(--s-4) var(--s-6);
    }

    .sheet a {
      color: var(--text);
      text-decoration: none;
      font-weight: var(--fw-medium);
      padding: var(--s-3);
      border-radius: var(--radius-sm);
    }

    .sheet a:hover {
      background: var(--hover);
    }

    .sheet-cta {
      background: var(--green);
      color: var(--on-accent);
      text-align: center;
      margin-top: var(--s-2);
      font-weight: var(--fw-semibold);
    }
  }
</style>
