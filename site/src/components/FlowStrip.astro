---
import { Icon } from 'astro-icon/components';

/*
 * The four hops, page to token. This is the only way to explain why a website
 * needs a helper app installed, and it doubles as the privacy claim, so it goes
 * near the top of the home page and again on /how-it-works.
 *
 * Matches the chain in docs/architecture.md. If that changes, this changes.
 */
const hops = [
  { icon: 'lucide:globe', name: 'Web page', note: 'docsigner.js' },
  { icon: 'lucide:puzzle', name: 'Extension', note: 'relays, no crypto' },
  { icon: 'lucide:terminal', name: 'Helper app', note: '1 MB, on your machine' },
  { icon: 'lucide:usb', name: 'USB token', note: 'holds the private key' },
];
---

<div class="flow">
  <ol>
    {
      hops.map((h, i) => (
        <>
          <li>
            <Icon name={h.icon} aria-hidden="true" />
            <span class="name">{h.name}</span>
            <span class="note">{h.note}</span>
          </li>
          {i < hops.length - 1 && (
            <li class="arrow" aria-hidden="true">
              <Icon name="lucide:chevron-right" />
            </li>
          )}
        </>
      ))
    }
  </ol>

  <p class="caption">
    The private key never leaves the token, and the PDF never leaves your server.
    The browser carries a <strong>32-byte hash</strong> out and a
    <strong>256-byte signature</strong> back, so a 200 MB file signs as fast as a
    200 KB one.
  </p>
</div>

<style>
  .flow {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  ol {
    list-style: none;
    padding: 0;
    display: flex;
    align-items: stretch;
    gap: var(--s-2);
  }

  li:not(.arrow) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--s-4);
    min-width: 0;
  }

  li :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--green-ink);
    margin-bottom: var(--s-2);
  }

  .name {
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
  }

  .note {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .arrow {
    display: grid;
    place-items: center;
    flex: none;
  }

  .arrow :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--border-strong);
    margin: 0;
  }

  .caption {
    color: var(--dim);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }

  .caption strong {
    color: var(--text);
    font-weight: var(--fw-semibold);
  }

  @media (max-width: 760px) {
    ol {
      flex-direction: column;
      align-items: stretch;
    }

    .arrow {
      padding-block: var(--s-1);
    }

    .arrow :global(svg) {
      transform: rotate(90deg);
    }
  }
</style>
