---
import { Icon } from 'astro-icon/components';

/*
 * The demo page, in browser chrome. Reproduced from demo/index.html rather than
 * screenshotted, so it takes the theme and stays sharp at any width.
 *
 * The prototype rendered this at a natural 660px and then scaled it to fit,
 * which is why its desktop-app shot ended up at 0.42 on a phone with the file
 * list at about 5px. Nothing is scaled here: the form is a single column, so it
 * just reflows, and the type stays at its real size everywhere.
 */
---

<figure class="shot">
  <div class="frame">
    <div class="bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="url">
        <Icon name="lucide:lock" aria-hidden="true" />
        accounts.yourcompany.in/invoices/4412
      </span>
    </div>

    <div class="body">
      <div class="page">
        <div class="card">
          <p class="card-head label"><span class="step">1</span> Document</p>
          <div class="field">
            <span class="flabel">What to sign</span>
            <span class="control">PDF (PAdES / CCA signature inside the file)</span>
          </div>
          <div class="field">
            <span class="flabel">Sign with</span>
            <span class="control">USB token (browser extension)</span>
          </div>
          <span class="control file">invoice_2026_0412.pdf</span>
        </div>

        <div class="card">
          <p class="card-head label">
            <span class="step">2</span> Certificate
            <span class="state">1 listed</span>
          </p>
          <div class="field">
            <span class="flabel">Signer</span>
            <span class="control">Smit Vora · token · to 2027-04-11</span>
          </div>
        </div>

        <div class="card">
          <p class="card-head label"><span class="step">3</span> Signature</p>
          <div class="field">
            <span class="flabel">Profile</span>
            <span class="control">CCA-LTA (India: CCA-LTV plus RFC 3161 timestamp)</span>
          </div>
        </div>

        <span class="sign">Sign</span>
      </div>
    </div>
  </div>
  <figcaption class="label">Your page, your server. The extension only carries the hash.</figcaption>
</figure>

<style>
  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .frame {
    border: var(--hairline);
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 34px;
    padding-inline: var(--s-3);
    background: var(--surface);
    border-bottom: var(--hairline);
  }

  .dots {
    display: flex;
    gap: 6px;
    flex: none;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: var(--pill);
    background: var(--border-strong);
  }

  .url {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--faint);
    background: var(--well);
    border-radius: var(--pill);
    padding: 3px var(--s-3);
    overflow: hidden;
    white-space: nowrap;
    min-width: 0;
  }

  .url :global(svg) {
    width: var(--icon-xs);
    height: var(--icon-xs);
    color: var(--green-ink);
  }

  .body {
    background: var(--bg-deep);
  }

  .page {
    max-width: 560px;
    margin-inline: auto;
    padding: var(--s-6) var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .card {
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--radius);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .card-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }

  .step {
    color: var(--action-ink);
    font-variant-numeric: tabular-nums;
  }

  .state {
    margin-left: auto;
    letter-spacing: 0;
    text-transform: none;
    color: var(--dim);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .flabel {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--faint);
  }

  .control {
    display: block;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius-sm);
    background: var(--well);
    border: var(--hairline);
    font-size: var(--text-sm);
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .control.file {
    border-style: dashed;
    border-color: var(--border-strong);
    color: var(--dim);
  }

  .sign {
    display: grid;
    place-items: center;
    height: var(--control-h-lg);
    border-radius: var(--radius-sm);
    background: var(--green);
    color: var(--on-accent);
    font-weight: var(--fw-semibold);
  }

  figcaption {
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .page {
      padding: var(--s-4) var(--s-3);
      gap: var(--s-3);
    }

    /* The URL is the first thing that has to give on a phone. It keeps
       --text-xs and truncates instead of dropping below the ladder. */
    .url {
      padding-inline: var(--s-2);
    }
  }
</style>
