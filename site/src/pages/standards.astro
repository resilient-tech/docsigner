---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProfilePicker from '../components/ProfilePicker.astro';

/*
 * The picker is the only listing of the six profiles. There used to be a table
 * of all of them underneath, with the same three columns the picker's panels
 * already show, so it went.
 */

const skipped = [
  ['Safari', 'The extension needs a signed macOS app wrapper around it. Parked until someone asks.'],
  [
    'EU trust lists',
    'EU trust arrives as signed per-country XML and needs its own parser. A folder of PEM files covers every other region.',
  ],
  ['RSA-PSS', 'Nearly every DSC token in the field uses PKCS#1 v1.5.'],
];
---

<Layout
  title="Standards"
  description="Which signature profiles DocSigner produces, from PAdES B-B to B-LTA and India's CCA-LTV and CCA-LTA, and what each one needs configured before it will sign."
>
  <Hero
    title="What the signature claims"
    lede="The longer a signature has to last, the more you set up. Start here."
  />

  <Section>
    <ProfilePicker />

    <p class="after">
      PAdES per ETSI EN 319 142-1. The output opens as signed in Adobe Reader and
      passes the EU DSS validator.
    </p>
  </Section>

  <Section label="Beyond PDF" title="Two other shapes">
    <div class="pair">
      <div>
        <h3>Detached CAdES</h3>
        <p>
          A <code>.p7s</code> beside any file, of any type, signed by the token
          or by a server key. Use it when the thing being signed is not a
          document: an archive, a database dump, a firmware image.
        </p>
      </div>
      <div>
        <h3>Enveloped XAdES</h3>
        <p>
          The signature sits inside the XML it signs. Server-held keys only, for
          now, because the token flow has nobody asking for it yet.
        </p>
      </div>
    </div>
  </Section>

  <Section label="Keys" title="What it will sign with">
    <dl class="keys">
      <div>
        <dt class="label">Algorithms</dt>
        <dd>RSA and ECDSA</dd>
      </div>
      <div>
        <dt class="label">Digests</dt>
        <dd>SHA-256, SHA-384, SHA-512</dd>
      </div>
      <div>
        <dt class="label">Timestamp authorities</dt>
        <dd>DigiCert, Sectigo, Certum, Entrust, SSL.com, or your own</dd>
      </div>
    </dl>
    <p class="after">
      The roots for those authorities ship with the server, so a timestamp
      validates for the long-lived profiles without you fetching anything.
    </p>
  </Section>
</Layout>

<style>
  .after {
    margin-top: var(--s-6);
    font-size: var(--text-body);
    color: var(--faint);
    max-width: var(--measure);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-8);
  }

  .pair h3 {
    letter-spacing: 0;
    margin-bottom: var(--s-2);
  }

  .pair p {
    font-size: var(--text-body);
    color: var(--dim);
    max-width: 46ch;
  }

  .keys {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s-6);
    margin: 0;
  }

  .keys dd {
    margin: var(--s-2) 0 0;
    font-size: var(--text-body);
    color: var(--text);
  }


</style>
