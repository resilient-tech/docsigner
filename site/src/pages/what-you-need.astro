---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { links } from '../config';

/*
 * The page that answers "which of these do I install".
 *
 * Organised by the job, not by the repository layout. Somebody arrives knowing
 * what they want to do, not which of seven packages does it, and the honest
 * answer for three of the four jobs is "fewer pieces than you think".
 *
 * The piece names below are the real ones, and the "what it is" column is short
 * on purpose: the function matters here, the codename is just how you find it.
 */

const jobs = [
  {
    icon: 'lucide:folder-check',
    who: 'I have a token and a folder of PDFs',
    title: 'Sign them now, on this machine',
    need: ['Desktop app'],
    body: 'One app. It bundles its own helper, signs every PDF in the folder against your token, and asks for the PIN once for the whole run.',
    not: 'No server, no browser, no extension.',
    cta: { href: '/download', label: 'Download the app' },
  },
  {
    icon: 'lucide:code',
    who: 'I am adding signing to our web app',
    title: 'Your page, your server, their token',
    need: ['Page library', 'Server', 'Extension', 'Helper app'],
    body: 'Your page calls the library, your server does the signing, and the two browser pieces are what the signer installs once. The document never leaves your server.',
    not: 'Your users install the extension and the helper. You install the rest.',
    cta: { href: '/how-it-works', label: 'See the sequence' },
  },
  {
    icon: 'lucide:cog',
    who: 'A system signs, with nobody watching',
    title: 'Invoices on submit, statements on a schedule',
    need: ['Server'],
    body: 'The key sits on the server as a .p12 and one HTTP call returns a signed file. Same signing engine as the token flow, minus everything that needs a person.',
    not: 'No extension, no helper, no PIN prompt.',
    cta: { href: '/standards', label: 'Which profiles it can produce' },
  },
  {
    icon: 'lucide:receipt',
    who: 'We run ERPNext',
    title: 'Sign print formats from the desk',
    need: ['Frappe app'],
    body: 'Bulk-sign with one PIN, auto-sign on submit, and QR-verifiable e-copies. It embeds the signing engine directly, so there is no separate server to run.',
    not: 'Ships from its own repository, docsigner_integration.',
    cta: { href: links.roadmap, label: 'Read the plan' },
  },
];

/* Named by what they do. The codename is how you find it on disk, and that is
   the only reason it is here. */
const pieces = [
  {
    name: 'Desktop app',
    id: 'docsigner-desktop',
    what: 'Signs a folder of PDFs against a token. Carries its own helper.',
    who: 'Installed by the person signing',
  },
  {
    name: 'Extension',
    id: 'Chrome, Edge, Brave, Firefox',
    what: 'Carries messages between a web page and the helper. Does no cryptography.',
    who: 'Installed by the person signing',
  },
  {
    name: 'Helper app',
    id: 'docsigner-host',
    what: 'Reads certificates off the token and shows the PIN dialog. About a megabyte of Rust, and the only piece that touches hardware.',
    who: 'Installed by the person signing',
  },
  {
    name: 'Page library',
    id: 'docsigner.js',
    what: 'The five functions a page calls. One file, no dependencies.',
    who: 'Shipped by you, in your app',
  },
  {
    name: 'Server',
    id: 'docsigner-server',
    what: 'Holds the document, prepares the signature, embeds the answer. An HTTP API over the engine.',
    who: 'Run by you',
  },
  {
    name: 'Signing engine',
    id: 'docsigner-core',
    what: 'Turns a PDF into a signed PDF, with pyHanko underneath. Everything else calls this.',
    who: 'A dependency of the above',
  },
  {
    name: 'Frappe app',
    id: 'docsigner_integration',
    what: 'ERPNext signing: print formats, bulk runs, auto-sign on submit.',
    who: 'Installed on your bench',
  },
];
---

<Layout
  title="What you need"
  description="Which parts of DocSigner to install, organised by what you are trying to do: signing a folder of PDFs, adding signing to a web app, signing without a person present, or ERPNext."
>
  <Hero
    kicker="What you need"
    title="Four jobs, and the parts each one takes"
    lede="Most of these need fewer pieces than the list suggests. Find your row."
  />

  <Section ground="deep">
    <div class="jobs">
      {
        jobs.map((j) => (
          <article class="job">
            <header>
              <span class="job-ic"><Icon name={j.icon} aria-hidden="true" /></span>
              <p class="who">{j.who}</p>
              <h2>{j.title}</h2>
            </header>

            <p class="body">{j.body}</p>

            <ul class="need" aria-label="Parts you need">
              {j.need.map((n) => <li>{n}</li>)}
            </ul>

            <p class="not">{j.not}</p>

            <Button
              href={j.cta.href}
              variant="default"
              size="sm"
              trailing={j.cta.href.startsWith('http')
                ? 'lucide:external-link'
                : 'lucide:arrow-right'}
            >
              {j.cta.label}
            </Button>
          </article>
        ))
      }
    </div>
  </Section>

  <Section
    label="The parts"
    title="Every piece, and who installs it"
    lede="Seven names, and you will never need all seven at once."
  >
    <div class="parts scroll-x">
      <table>
        <thead>
          <tr>
            <th>Part</th>
            <th>What it does</th>
            <th>Who installs it</th>
          </tr>
        </thead>
        <tbody>
          {
            pieces.map((p) => (
              <tr>
                <td>
                  <span class="pname">{p.name}</span>
                  <code>{p.id}</code>
                </td>
                <td>{p.what}</td>
                <td class="whocol">{p.who}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="after">
      The split matters when you are integrating: the extension and the helper are
      installed once by whoever holds the token, and everything else is yours to
      run. <a href="/how-it-works">How it works</a> shows why that division
      exists.
    </p>
  </Section>
</Layout>

<style>
  /* Two up, not auto-fit. Four cards on an auto-fit grid land 3 + 1 at desktop
     widths, and a lone card on its own row reads as a mistake. 2x2 also gives
     the longer bodies a wider column. */
  .jobs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }

  /* --bp-md */
  @media (max-width: 768px) {
    .jobs {
      grid-template-columns: 1fr;
    }
  }

  /* Card recipe: surface, one hairline, --radius, --s-6, no shadow. */
  .job {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--radius);
    padding: var(--s-6);
  }

  .job header {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .job-ic {
    color: var(--green-ink);
    margin-bottom: var(--s-2);
  }

  .job-ic :global(svg) {
    width: var(--icon-md);
    height: var(--icon-md);
  }

  /* The reader's own words, so they can find themselves in one scan. */
  .who {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--faint);
  }

  .job h2 {
    font-size: var(--display-3);
    letter-spacing: 0;
  }

  .body {
    font-size: var(--text-sm);
    color: var(--dim);
  }

  .need {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  /* Chip: pill, hairline, --text-xs semibold. */
  .need li {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    color: var(--green-ink);
    background: var(--green-soft);
    border: 1px solid var(--green);
    border-radius: var(--pill);
    padding: 2px var(--s-2);
  }

  .not {
    font-size: var(--text-xs);
    color: var(--faint);
    margin-top: auto;
  }

  /* ---- the parts table ---- */
  .parts {
    border: var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    min-width: 620px;
  }

  th {
    text-align: left;
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--faint);
    padding: var(--s-3) var(--s-4);
    border-bottom: var(--hairline);
    white-space: nowrap;
  }

  td {
    padding: var(--s-4);
    border-bottom: var(--hairline);
    color: var(--dim);
    vertical-align: top;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  .pname {
    display: block;
    color: var(--text);
    font-weight: var(--fw-semibold);
    white-space: nowrap;
  }

  td code {
    font-size: var(--text-xs);
    background: none;
    border: 0;
    padding: 0;
    color: var(--faint);
    white-space: nowrap;
  }

  .whocol {
    color: var(--faint);
  }

  .after {
    margin-top: var(--s-6);
    font-size: var(--text-sm);
    color: var(--dim);
    max-width: var(--measure);
  }
</style>
