---
import Layout from '../components/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import HeroSheet from '../components/HeroSheet.astro';
import Surfaces from '../components/Surfaces.astro';

/*
 * Four blocks: what it is, what it looks like, why it exists, go.
 *
 * There is no "how it works" section here any more. It was the byte-counter
 * wire, and /how-it-works now has a steppable version of the same sequence that
 * says everything the wire said and more. Two takes on one mechanism is one too
 * many, and the landing page is the one that should give.
 *
 * The standards ladder is gone from here too. It is a table of configuration
 * detail, and /standards is where somebody goes looking for it.
 */
---

<Layout
  title="DocSigner"
  description="Open-source PDF signing. Use the DSC token you already have, on a server you control."
>
  <!-- The whole statement, on one screen. -->
  <Section full class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>Open-source PDF signing</h1>
        <p class="lede">
          Use the DSC token you already have, on a server you control.
        </p>
        <div class="hero-cta">
          <Button href="/download" variant="primary" size="lg">Download</Button>
        </div>
      </div>
      <!-- A page with a signature on it, and nothing to read. The letterhead
           belongs in the prototypes, where the document is the subject. -->
      <div class="hero-art paper" aria-hidden="true">
        <HeroSheet />
      </div>
    </div>
  </Section>

  <Section label="What it looks like" title="Two places it happens">
    <Surfaces />
  </Section>

  <Section ground="deep" label="Why it exists" title="Nothing else would do it">
    <div class="why">
      <p>
        Every tool that signs with a token is commercial, or Windows-only, or
        both. The open-source ones stop at keys in a file, which is not where a
        DSC lives.
      </p>
      <p>Every signature made this way is one less page printed and posted.</p>
      <Button href="/why" variant="default" size="md" trailing="lucide:arrow-right">
        The longer story
      </Button>
    </div>
  </Section>

  <Section centre>
    <div class="end">
      <h2>Sign something</h2>
      <p class="lede">It takes one PIN and about a minute to set up.</p>
      <Button href="/download" variant="primary" size="lg">Download</Button>
    </div>
  </Section>
</Layout>

<style>
  /* ---- hero ---- */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: var(--s-16);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  /* One tier above --display-1: the headline is the page. No cap of its own,
     the column is already the measure and capping it forced hyphen breaks. */
  .hero-copy h1 {
    font-size: var(--display-hero);
    max-width: none;
  }

  .hero-copy .lede {
    max-width: 40ch;
  }

  .hero-cta {
    margin-top: var(--s-2);
  }

  /* A page on a desk, not a screenshot in a box. */
  /* A page on a desk, not a screenshot in a box. */
  .hero-art {
    padding: var(--s-6) var(--s-6) var(--s-8);
    transform: rotate(-1.4deg);
    box-shadow: var(--shadow-lift);
  }

  /* ---- why ---- */
  .why {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    max-width: 58ch;
    color: var(--dim);
  }

  /* ---- close ---- */
  .end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
  }

  /* --bp-lg */
  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }

    .hero-copy .lede {
      max-width: var(--measure-h1);
    }

    /* Copy leads when stacked: the headline has to be read first. */
    .hero-art {
      max-width: 440px;
    }
  }

  @media (max-width: 640px) {
    .hero-art {
      transform: none;
      padding: var(--s-4);
    }
  }
</style>
