---
import Layout from '../components/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import HeroSheet from '../components/HeroSheet.astro';
import Surfaces from '../components/Surfaces.astro';
import { Icon } from 'astro-icon/components';

/*
 * Four blocks: what it is, what it looks like, why it exists, go.
 *
 * There is no "how it works" section here any more. It was the byte-counter
 * wire, and /how-it-works now has a steppable version of the same sequence that
 * says everything the wire said and more. Two takes on one mechanism is one too
 * many, and the landing page is the one that should give.
 *
 * The standards ladder is gone from here too. It is a table of configuration
 * detail, and /standards is where somebody goes looking for it.
 */
---

<Layout
  title="DocSigner"
  description="Open-source PDF signing. Use the DSC token you already have, on a server you control."
>
  <!-- The whole statement, on one screen. -->
  <Section full class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>Open-source PDF signing</h1>
        <p class="lede">
          Use the DSC token you already have, on a server you control.
        </p>
        <div class="hero-cta">
          <Button href="/download" variant="primary" size="lg">Download</Button>
        </div>
      </div>
      <!-- A page with a signature on it, and nothing to read. The letterhead
           belongs in the prototypes, where the document is the subject. -->
      <div class="hero-art paper" aria-hidden="true">
        <HeroSheet />
      </div>
    </div>
  </Section>

  <Section label="What it looks like" title="Where you actually sign">
    <Surfaces />
  </Section>

  <Section label="Why it exists" title="No tool would do it">
    <div class="why-grid">
      <div class="why">
        <p>A DSC token on Linux left three options, and we wanted a fourth.</p>
        <p>
          Open source was no help either. Those tools sign happily with a key in
          a file, and a DSC does not live in a file.
        </p>
        <Button href="/why" variant="default" size="md" trailing="lucide:arrow-right">
          The longer story
        </Button>
      </div>

      <!-- The three the paragraph counts, and the fourth. Said once: the prose
           used to list them too, which meant reading the same three phrases
           twice for one new word. -->
      <ul class="options">
        <li><Icon name="lucide:x" aria-hidden="true" /><s>Pay for a Windows-only tool</s></li>
        <li><Icon name="lucide:x" aria-hidden="true" /><s>Reboot into Windows</s></li>
        <li><Icon name="lucide:x" aria-hidden="true" /><s>Print it and sign by hand</s></li>
        <li class="live"><Icon name="lucide:check" aria-hidden="true" />Run this</li>
      </ul>
    </div>
  </Section>

  <Section centre>
    <div class="end">
      <h2>Sign something</h2>
      <p class="lede">No account, no licence key, nothing leaves your machine.</p>
      <Button href="/download" variant="primary" size="lg">Download</Button>
    </div>
  </Section>
</Layout>

<style>
  /* ---- hero ---- */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: var(--s-16);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  /* One tier above --display-1: the headline is the page. No cap of its own,
     the column is already the measure and capping it forced hyphen breaks. */
  .hero-copy h1 {
    font-size: var(--display-hero);
    max-width: none;
  }

  .hero-copy .lede {
    max-width: 40ch;
  }

  .hero-cta {
    margin-top: var(--s-2);
  }

  /* A page on a desk, not a screenshot in a box. */
  /* A page on a desk, not a screenshot in a box. */
  .hero-art {
    padding: var(--s-6) var(--s-6) var(--s-8);
    transform: rotate(-1.4deg);
    box-shadow: var(--shadow-lift);
  }

  /* ---- why ---- */
  /* The paragraph rules out three options; the tiles answer them in order, and
     they sit in the space the prose was leaving empty. */
  /* Equal halves. The old 1fr + 360px left the prose column wider than its own
     58ch cap, so 106px of it could never hold anything. */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-12);
    align-items: start;
  }

  /* Pulled up by its own top padding so the first row sits on the same line as
     the first line of prose. Aligning the boxes instead left the card's text
     20px low, which is the padding and reads as a mistake. */
  .options {
    list-style: none;
    margin-top: calc(-1 * var(--s-5));
    padding: var(--s-5) var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--radius-lg);
  }

  .options li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--faint);
  }

  .options :global(svg) {
    width: var(--icon-sm);
    height: var(--icon-sm);
    flex: none;
  }

  .options s {
    text-decoration-thickness: 1px;
  }

  /* The fourth, and the only one that is not crossed out. */
  .options .live {
    color: var(--text);
    font-weight: var(--fw-semibold);
  }

  .options .live :global(svg) {
    color: var(--green-ink);
  }

  .why {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    color: var(--dim);
  }

  /* ---- close ---- */
  /* Centred, and the only centred thing on the page. It carries no label, so it
     is not a section announcing a subject: it is the end of the page, and
     centring is what says so. */
  .end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
  }

  /* --bp-lg */
  @media (max-width: 1024px) {
    .why-grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }

    .hero-copy .lede {
      max-width: var(--measure-h1);
    }

    /* Copy leads when stacked: the headline has to be read first. */
    .hero-art {
      max-width: 440px;
    }
  }

  @media (max-width: 640px) {
    .hero-art {
      transform: none;
      padding: var(--s-4);
    }
  }
</style>
