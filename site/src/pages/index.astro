---
import Layout from '../components/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import HeroSheet from '../components/HeroSheet.astro';
import Wire from '../components/Wire.astro';
import SurfaceCard from '../components/SurfaceCard.astro';
import { links, REPO_PUBLIC, ready } from '../config';

/*
 * Five screens. Four of them fill the viewport and snap; the closing band does
 * not, because it holds one sentence and a button and a half-empty 100svh is
 * worse than an honest short one.
 *
 * Slide 2 is the spine: three surfaces, read as "which of these am I", because
 * three different people arrive here wanting three different first steps.
 */

const profiles = [
  ['B-B', 'The signature.'],
  ['B-T', 'RFC 3161 timestamp.'],
  ['B-LT', 'Embedded revocation data, OCSP or CRL.'],
  ['B-LTA', 'Archival timestamp chain on top of B-LT.'],
  ['CCA-LTV', "India's CCA variant, per ESAIG 1.19."],
  ['CCA-LTA', 'CCA-LTV plus an RFC 3161 timestamp.'],
];
---

<Layout
  title="DocSigner"
  description="Open-source digital signatures for PDFs. Sign with a USB token from any website, from a desktop app, or from ERPNext. Self-hosted, Apache-2.0, PAdES and India's CCA profiles."
>
  <!-- 1 ─ what it is, and the artifact it produces -->
  <Section full class="hero centred">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="label">Apache-2.0 · PAdES and India's CCA profiles</p>
        <h1>Sign PDFs with a USB token, from any website</h1>
        <p class="lede">
          Self-hosted and open source. The document stays on your server: the
          browser carries a 32-byte hash out and a signature back.
        </p>
        <div class="hero-cta">
          <Button href="/download" variant="primary" size="lg">Download</Button>
        </div>
      </div>
      <div class="hero-art paper" aria-hidden="true">
        <HeroSheet />
      </div>
    </div>
  </Section>

  <!-- 2 ─ the router. Three people, three first steps. -->
  <Section
    full
    ground="deep"
    label="Three ways in"
    title="Which of these are you?"
    lede="One signing engine underneath all three. What changes is where it runs and who holds the key."
  >
    <div class="surfaces">
      <SurfaceCard
        icon="lucide:globe"
        who="For developers"
        title="In your own web app"
        body="Your page asks the token for a signature and your server does the rest. One JS file with no dependencies, and an HTTP API behind it."
        href={REPO_PUBLIC ? links.docsJs : undefined}
        cta="Read the page library docs"
        pending="Docs open up when the repository goes public."
      />
      <SurfaceCard
        icon="lucide:folder-check"
        who="For anyone with a DSC"
        title="A folder of PDFs, right now"
        body="A desktop app that signs every PDF in a folder against your token, one PIN for the run. No server, no browser, no extension."
        href="/download"
        cta="Download the app"
      />
      <SurfaceCard
        icon="lucide:receipt"
        who="For ERPNext admins"
        title="Invoices, on submit"
        body="A Frappe app: sign print formats from the desk, bulk-sign with one PIN, auto-sign on submit, and QR-verifiable e-copies."
        href={REPO_PUBLIC ? links.roadmap : undefined}
        cta="Read the plan"
        pending="Ships in its own repo, docsigner_integration."
      />
    </div>
  </Section>

  <!-- 3 ─ how, once, without theatre -->
  <Section
    full
    label="How it works"
    title="The token signs 32 bytes, not the file"
    lede="A token holds a private key and will not hand it over. So the server prepares the signature inside the PDF, the token signs one small hash, and the server puts the answer back."
  >
    <Wire />
  </Section>

  <!-- 4 ─ what the signature actually claims -->
  <Section
    full
    ground="deep"
    label="Standards"
    title="What the signature claims"
    lede="PAdES B-B through B-LTA per ETSI EN 319 142-1, and India's CCA profiles with revocation data in the pdfRevocationInfoArchival attribute."
  >
    <div class="std">
      <div class="std-table scroll-x">
        <table>
          <thead>
            <tr><th>Profile</th><th>What it adds</th></tr>
          </thead>
          <tbody>
            {
              profiles.map(([p, what]) => (
                <tr>
                  <td><code>{p}</code></td>
                  <td>{what}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="std-notes">
        <p>
          Beyond PDF: detached CAdES-BES over any file, and enveloped XAdES-B
          over XML with a server-held key. RSA and ECDSA, SHA-256, 384 and 512.
        </p>
        <p>
          Signed output validates as PAdES in Adobe and in the EU DSS validator.
        </p>
        <p class="no-overrides">
          No localhost certificate to trust, no <code>/etc/hosts</code> entry, no
          Java. Reaching the token needs none of them.
        </p>
      </div>
    </div>
  </Section>

  <!-- 5 ─ the close. Deliberately not full height. -->
  <Section ground="bg" centre>
    <div class="end">
      <h2>Sign something</h2>
      <p class="lede">
        The helper is about 1 MB of Rust. The page library is one file with no
        dependencies.
      </p>
      <Button href="/download" variant="primary" size="lg">Download</Button>
      {
        !REPO_PUBLIC && (
          <p class="note">
            Nothing is published yet: the first release waits on the repository
            going public, and the extension has not been submitted to either
            store.
          </p>
        )
      }
    </div>
  </Section>
</Layout>

<style>
  /* ---- 1 hero ---- */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    gap: var(--s-16);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .hero-cta {
    margin-top: var(--s-4);
  }

  /* The sheet sits slightly off-square, the way a page does on a desk. */
  .hero-art {
    padding: var(--s-6) var(--s-6) var(--s-8);
    transform: rotate(-1.4deg);
    box-shadow: var(--shadow-lift);
  }

  /* ---- 2 router ---- */
  .surfaces {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-4);
    align-items: stretch;
  }

  /* ---- 4 standards ---- */
  .std {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-8);
    align-items: start;
  }

  .std-table {
    border: var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  th {
    text-align: left;
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--faint);
    padding: var(--s-3) var(--s-4);
    border-bottom: var(--hairline);
  }

  td {
    padding: var(--s-3) var(--s-4);
    border-bottom: var(--hairline);
    color: var(--dim);
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  td:first-child {
    color: var(--text);
    white-space: nowrap;
  }

  .std-notes {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    color: var(--dim);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }

  .no-overrides {
    padding-left: var(--s-4);
    border-left: var(--accent-bar) solid var(--green);
    color: var(--text);
  }

  /* ---- 5 close ---- */
  .end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
  }

  .end .note {
    font-size: var(--text-sm);
    color: var(--faint);
    max-width: 52ch;
    margin-top: var(--s-2);
  }

  /* --bp-lg: the hero's two columns and the standards split both need room. */
  @media (max-width: 1024px) {
    .hero-grid,
    .std {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }

    .hero-grid {
      gap: var(--s-8);
    }

    /* The sheet follows the copy when stacked. Leading with it looked better and
       pushed the headline and the one call to action below the fold on a phone,
       which is the wrong trade on the screen that has to say what this is. */
    .hero-art {
      max-width: 420px;
    }
  }

  @media (max-width: 640px) {
    .hero-art {
      transform: none;
      padding: var(--s-4);
    }
  }
</style>
