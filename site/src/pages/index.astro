---
import Layout from '../components/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import HeroSheet from '../components/HeroSheet.astro';
import ProductShot from '../components/ProductShot.astro';
import Wire from '../components/Wire.astro';

/*
 * The hero is the only full-height section. Everything under it is as short as
 * it can be and still be true.
 *
 * There is no "which of these are you" block here any more. Routing three
 * audiences is the navigation's job, not a slab in the middle of a landing page.
 * That content moved to /how-it-works.
 */

const profiles = [
  ['B-B', 'The signature.'],
  ['B-T', 'A timestamp, per RFC 3161.'],
  ['B-LT', 'Revocation data embedded, OCSP or CRL.'],
  ['B-LTA', 'An archival timestamp chain on top of B-LT.'],
  ['CCA-LTV', "India's CCA variant, per ESAIG 1.19."],
  ['CCA-LTA', 'CCA-LTV, plus a timestamp.'],
];
---

<Layout
  title="DocSigner"
  description="Open-source PDF signing. Use the DSC token you already have, on a server you control. Apache-2.0, every piece of it."
>
  <!-- The whole statement, on one screen. -->
  <Section full class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>Open-source PDF signing</h1>
        <p class="lede">
          Use the DSC token you already have, on a server you control.
        </p>
        <div class="hero-cta">
          <Button href="/download" variant="primary" size="lg">Download</Button>
        </div>
      </div>
      <div class="hero-art paper" aria-hidden="true">
        <HeroSheet />
      </div>
    </div>
  </Section>

  <Section ground="deep" label="What it looks like" title="Signing, on your own page">
    <div class="shot-wrap">
      <ProductShot />
    </div>
  </Section>

  <Section
    label="How it works"
    title="The token only ever sees 32 bytes"
    lede="A token holds a private key and will not hand it over. So your server builds the signature inside the PDF, the token signs one small hash, and your server puts the answer back."
  >
    <Wire />
  </Section>

  <Section ground="deep" label="Standards" title="Signatures that outlive the certificate">
    <div class="std">
      <p>
        PAdES B-B through B-LTA, and India's CCA-LTV and CCA-LTA. The long-lived
        profiles embed their own revocation data and timestamps, so a signature
        still checks out years after the certificate behind it expired.
      </p>
      <p class="no-overrides">
        Nothing to click past on the way there: no localhost certificate to
        trust, no <code>/etc/hosts</code> line, no Java.
      </p>
      <Button href="/standards" variant="default" size="md" trailing="lucide:arrow-right">
        Every profile, and what it needs
      </Button>
    </div>
  </Section>

  <Section centre>
    <div class="end">
      <h2>Sign something</h2>
      <p class="lede">
        The helper is about a megabyte. The page library is one file, no
        dependencies.
      </p>
      <Button href="/download" variant="primary" size="lg">Download</Button>
      <p class="note">
        Free, and it stays free. If something does not work, the issue tracker is
        the same one we use.
      </p>
    </div>
  </Section>
</Layout>

<style>
  /* ---- hero ---- */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: var(--s-16);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  /* One tier above --display-1: the headline is the page. No cap of its own,
     the column is already the measure and capping it forced hyphen breaks. */
  .hero-copy h1 {
    font-size: var(--display-hero);
    max-width: none;
  }

  .hero-copy .lede {
    max-width: 40ch;
  }

  .hero-cta {
    margin-top: var(--s-2);
  }

  /* A page on a desk, not a screenshot in a box. */
  .hero-art {
    padding: var(--s-6) var(--s-6) var(--s-8);
    transform: rotate(-1.4deg);
    box-shadow: var(--shadow-lift);
  }

  /* ---- product shot ---- */
  .shot-wrap {
    max-width: 760px;
  }

  /* ---- standards ---- */
  .std {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    max-width: var(--measure);
    color: var(--dim);
    font-size: var(--text-sm);
  }

  .no-overrides {
    padding-left: var(--s-4);
    border-left: var(--accent-bar) solid var(--green);
    color: var(--text);
  }

  /* ---- close ---- */
  .end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
  }

  .end .note {
    font-size: var(--text-sm);
    color: var(--faint);
    max-width: 52ch;
    margin-top: var(--s-2);
  }

  /* --bp-lg */
  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }

    .hero-copy .lede {
      max-width: var(--measure-h1);
    }

    /* Copy leads when stacked: the headline has to be read first, and the sheet
       peeking in below is what invites the scroll. */
    .hero-art {
      max-width: 440px;
    }
  }

  @media (max-width: 640px) {
    .hero-art {
      transform: none;
      padding: var(--s-4);
    }
  }
</style>
