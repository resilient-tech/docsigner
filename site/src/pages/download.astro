---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import DownloadCard from '../components/DownloadCard.astro';
import Callout from '../components/Callout.astro';
import { getRelease } from '../lib/release';
import { brew, stores, WINDOWS_SIGNED } from '../config';

const release = await getRelease();
const find = (key: string) => release.artifacts.find((a) => a.key === key);

const platforms = [
  { os: 'macos', title: 'macOS', icon: 'lucide:apple' },
  { os: 'windows', title: 'Windows', icon: 'lucide:monitor' },
  { os: 'linux', title: 'Linux', icon: 'lucide:terminal' },
];

const anyStore = Object.values(stores).some((s) => s.ready);
---

<Layout
  title="Download"
  description="DocSigner downloads: the browser extension, the native helper, and the desktop batch signer. One build per operating system."
>
  <Hero
    kicker={release.published ? `Version ${release.version}` : 'Unreleased'}
    title="Download"
    lede="One build per operating system. There is no architecture to pick."
  >
    {
      !release.published && (
        <div class="notice">
          <Callout tone="warn" title="The first release is not out yet">
            <p>
              Every build below is assembled and tested in CI on all three
              operating systems. This page fills itself in from the release feed,
              so the versions and checksums appear the moment one is published.
            </p>
          </Callout>
        </div>
      )
    }
  </Hero>

  <Section
    label="Step 1"
    title="Browser extension"
    lede="A web page cannot reach a USB token on its own. Skip this if your key lives on a server."
  >
    {
      anyStore ? (
        <div class="grid">
          {Object.entries(stores)
            .filter(([, s]) => s.ready)
            .map(([, s]) => (
              <DownloadCard
                title={s.label}
                blurb="Install from the store."
                icon="lucide:puzzle"
                version={release.version}
              />
            ))}
        </div>
      ) : (
        <div class="stack">
          <Callout tone="note" title="Store listings are still in review">
            <p>
              An extension that talks to a native app draws extra scrutiny, and
              both stores take weeks over it. Until they clear, install the zip
              directly: unpack it and load it from your browser’s extensions
              page. The build is the same one the stores will serve.
            </p>
          </Callout>
          <div class="grid">
            <DownloadCard
              title="Chrome, Edge, Brave"
              blurb="One zip for every Chromium browser."
              icon="lucide:chrome"
              version={release.version}
              artifact={find('extension-chrome')}
            />
            <DownloadCard
              title="Firefox"
              blurb="Its own zip: Firefox needs the Gecko id."
              icon="lucide:puzzle"
              version={release.version}
              artifact={find('extension-firefox')}
            />
          </div>
        </div>
      )
    }
  </Section>

  <Section
    ground="deep"
    label="Step 2"
    title="Native helper"
    lede="About 1 MB of Rust. The only piece that touches the token, and the only place your PIN is typed."
  >
    <div class="stack">
      {
        brew.ready && (
          <div class="grid">
            <DownloadCard
              title="Homebrew"
              blurb="macOS, and Linux via linuxbrew."
              icon="lucide:beer"
              version={release.version}
              command={brew.host}
            />
          </div>
        )
      }

      <div class="grid">
        {platforms.map((p) => (
          <DownloadCard
            title={p.title}
            blurb="Unpack and run the installer."
            icon={p.icon}
            version={release.version}
            artifact={find(`host-${p.os}`)}
            os={p.os}
          />
        ))}
      </div>

      <Callout tone="note" title="Will it work with your token?">
        <p>
          Tested on a real bench with a Capricorn token. The helper talks
          PKCS#11, which every DSC token speaks, so others are expected to work
          and several are already known to. There is no compatibility table yet
          because it should be built from real reports rather than guesses.
        </p>
        <p>
          If yours works, or does not, say so in an issue and it goes on the
          list.
        </p>
      </Callout>

      <Callout tone="note" title="macOS builds are x86_64, on purpose">
        <p>
          They run under Rosetta on Apple Silicon. Several token vendors ship
          x86_64-only PKCS#11 drivers, and a native arm64 build could not load
          them.
        </p>
      </Callout>

      {
        !WINDOWS_SIGNED && (
          <Callout tone="warn" title="Windows will warn you">
            <p>
              The Windows binaries are not code-signed yet, so SmartScreen shows
              “Unknown publisher” the first time you run one. Check the SHA-256
              above against the file and it is the build we published.
            </p>
          </Callout>
        )
      }
    </div>
  </Section>

  <Section
    label="Optional"
    title="Desktop batch signer"
    lede="Signs every PDF in a folder, one PIN for the run. No server, no browser, no extension."
  >
    <div class="stack">
      <div class="grid">
        {platforms.map((p) => (
          <DownloadCard
            title={p.title}
            blurb="Bundles its own helper."
            icon={p.icon}
            version={release.version}
            artifact={find(`desktop-${p.os}`)}
            os={p.os}
          />
        ))}
      </div>
    </div>
  </Section>
</Layout>

<script>
  /* Light up the card matching the visitor's OS. Nothing gets hidden: a guess
     that highlights helps, a guess that hides is a dead end. */
  import { detectOS } from '../lib/platform';

  const os = detectOS();
  if (os !== 'unknown') {
    for (const el of document.querySelectorAll<HTMLElement>(`.dl[data-os="${os}"]`)) {
      el.dataset.match = 'true';
    }
  }
</script>

<style>
  .notice {
    margin-top: var(--s-4);
    max-width: 720px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-4);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .aside {
    font-size: var(--text-sm);
    color: var(--faint);
    max-width: var(--measure);
  }
</style>
