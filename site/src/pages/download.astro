---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import DownloadCard from '../components/DownloadCard.astro';
import Callout from '../components/Callout.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { getRelease } from '../lib/release';
import { brew, stores, links, WINDOWS_SIGNED } from '../config';

/*
 * One page, three products.
 *
 * It used to be Step 1 / Step 2 / Optional, which is the install order and not
 * how anyone arrives. People come knowing the job, so the page is named by
 * product: web signer, desktop signer, server, ERPNext. The old /what-you-need
 * page is folded in here, because choosing and getting should not be two visits.
 *
 * Seven package names still exist and are still true; they are just not the
 * first thing you have to learn.
 */

const release = await getRelease();
const find = (key: string) => release.artifacts.find((a) => a.key === key);

const platforms = [
  { os: 'macos', title: 'macOS', icon: 'lucide:apple' },
  { os: 'windows', title: 'Windows', icon: 'lucide:monitor' },
  { os: 'linux', title: 'Linux', icon: 'lucide:terminal' },
];

const anyStore = Object.values(stores).some((s) => s.ready);

const products = [
  {
    id: 'web',
    icon: 'lucide:globe',
    name: 'Web signer',
    for: 'Sign from any website, with your token',
    body: 'Two small installs and any site that uses DocSigner can ask your token for a signature. Your documents go to that site’s own server, never to us.',
  },
  {
    id: 'desktop',
    icon: 'lucide:folder-check',
    name: 'Desktop signer',
    for: 'Sign a folder of PDFs, one PIN',
    body: 'One app, nothing else. Point it at a folder, pick a profile, type the PIN once. No server and no browser involved.',
  },
  {
    id: 'server',
    icon: 'lucide:server',
    name: 'Server',
    for: 'Sign without a person present',
    body: 'For invoices on submit and statements on a schedule. The key sits on the server and one HTTP call returns a signed file.',
  },
];
---

<Layout
  title="Download"
  description="DocSigner downloads by product: the web signer for signing from any site with your token, the desktop signer for a folder of PDFs, the server for unattended signing, and the ERPNext app."
>
  <Hero
    kicker={release.published ? `Version ${release.version}` : 'Download'}
    title="Three ways to sign"
    lede="Pick the one that matches the job."
  >
    {
      !release.published && (
        <div class="notice">
          <Callout tone="warn" title="The first release is not out yet">
            <p>
              Versions and checksums fill in from the release feed the moment one
              is published.
            </p>
          </Callout>
        </div>
      )
    }
  </Hero>

  <!-- The chooser. One card per product, each jumping to its own section. -->
  <Section ground="deep">
    <nav class="chooser" aria-label="Products">
      {
        products.map((p) => (
          <a href={`#${p.id}`}>
            <span class="ch-ic"><Icon name={p.icon} aria-hidden="true" /></span>
            <span class="ch-name">{p.name}</span>
            <span class="ch-for">{p.for}</span>
          </a>
        ))
      }
    </nav>
  </Section>

  <!-- ------------------------------------------------------ web signer -->
  <Section
    id="web"
    label="Web signer"
    title="Sign from any website, with your token"
    lede="Two installs, once. After that any site built on DocSigner can ask your token to sign, and the document stays on that site’s server."
  >
    <div class="stack">
      <div class="pair">
        <div>
          <h3>1. The extension</h3>
          <p class="sub">Carries messages between the page and the helper.</p>
        </div>
        <div>
          <h3>2. The helper app</h3>
          <p class="sub">Reads the token and asks for your PIN. About a megabyte.</p>
        </div>
      </div>

      {
        !anyStore && (
          <Callout tone="note" title="Store listings are still in review">
            <p>
              An extension that talks to a native app draws extra scrutiny. Until
              they clear, install the zip below: unpack it, then load it from your
              browser’s extensions page.
            </p>
          </Callout>
        )
      }

      <div class="grid">
        <DownloadCard
          title="Chrome, Edge, Brave"
          blurb="One zip for every Chromium browser."
          icon="lucide:chrome"
          version={release.version}
          artifact={find('extension-chrome')}
        />
        <DownloadCard
          title="Firefox"
          blurb="Its own zip: Firefox needs the Gecko id."
          icon="lucide:puzzle"
          version={release.version}
          artifact={find('extension-firefox')}
        />
      </div>

      <h3 class="sub-head">The helper app</h3>
      {
        brew.ready && (
          <div class="grid">
            <DownloadCard
              title="Homebrew"
              blurb="macOS, and Linux via linuxbrew."
              icon="lucide:beer"
              version={release.version}
              command={brew.host}
            />
          </div>
        )
      }
      <div class="grid">
        {platforms.map((p) => (
          <DownloadCard
            title={p.title}
            blurb="Unpack and run the installer."
            icon={p.icon}
            version={release.version}
            artifact={find(`host-${p.os}`)}
            os={p.os}
          />
        ))}
      </div>

      <Callout tone="note" title="Will it work with your token?">
        <p>
          The helper speaks PKCS#11, which every DSC token does. Tested on a real
          bench with a Capricorn token, and several others are known to work. If
          yours does or does not, an issue puts it on the list.
        </p>
      </Callout>

      {
        !WINDOWS_SIGNED && (
          <Callout tone="warn" title="Windows will warn you">
            <p>
              The Windows builds are not code-signed yet, so SmartScreen says
              “Unknown publisher” the first time. Check the SHA-256 and it is the
              build we published.
            </p>
          </Callout>
        )
      }

      <Callout tone="note" title="macOS builds are x86_64, on purpose">
        <p>
          They run under Rosetta on Apple Silicon. Several token vendors ship
          x86_64-only drivers, and a native arm64 build could not load them.
        </p>
      </Callout>
    </div>
  </Section>

  <!-- -------------------------------------------------- desktop signer -->
  <Section
    id="desktop"
    ground="deep"
    label="Desktop signer"
    title="A folder of PDFs, one PIN"
    lede="One app and nothing else. It carries its own helper, so there is no second install and no browser involved."
  >
    <div class="stack">
      {
        brew.ready && (
          <div class="grid">
            <DownloadCard
              title="Homebrew"
              blurb="macOS."
              icon="lucide:beer"
              version={release.version}
              command={brew.desktop}
            />
          </div>
        )
      }
      <div class="grid">
        {platforms.map((p) => (
          <DownloadCard
            title={p.title}
            blurb="Bundles its own helper."
            icon={p.icon}
            version={release.version}
            artifact={find(`desktop-${p.os}`)}
            os={p.os}
          />
        ))}
      </div>
    </div>
  </Section>

  <!-- ---------------------------------------------------------- server -->
  <Section
    id="server"
    label="Server"
    title="Signing with nobody watching"
    lede="The key sits on your server and one call returns a signed file. Same engine as the token flow, minus everything that needs a person."
  >
    <div class="stack">
      <div class="install">
        <p class="sub">Python 3.10 or newer.</p>
        <code>pip install docsigner-server</code>
      </div>
      <div class="links-row">
        <Button href={links.docsServer} variant="default" size="md" trailing="lucide:external-link">
          Server docs and API
        </Button>
        <Button href={links.docsJs} variant="ghost" size="md" trailing="lucide:external-link">
          The page library
        </Button>
      </div>
    </div>
  </Section>

  <Section
    ground="deep"
    label="Built on it"
    title="Or build your own"
    lede="The signing engine is a Python package, so anything that can import it can sign."
  >
    <div class="stack">
      <p class="sub">
        Our own ERPNext app does exactly that: print formats signed on submit,
        bulk runs on one PIN, copies anyone can verify from a QR. It is a separate
        project, not part of DocSigner, and it is the example worth copying.
      </p>
      <div class="links-row">
        <Button href={links.roadmap} variant="default" size="md" trailing="lucide:external-link">
          How the ERPNext app works
        </Button>
        <Button href={links.docsCore} variant="ghost" size="md" trailing="lucide:external-link">
          The signing engine
        </Button>
      </div>
    </div>
  </Section>
</Layout>

<script>
  /* Light up the card matching the visitor's OS. Nothing gets hidden: a guess
     that highlights helps, a guess that hides is a dead end. */
  import { detectOS } from '../lib/platform';

  const os = detectOS();
  if (os !== 'unknown') {
    for (const el of document.querySelectorAll<HTMLElement>(`.dl[data-os="${os}"]`)) {
      el.dataset.match = 'true';
    }
  }
</script>

<style>
  .notice {
    margin-top: var(--s-4);
    max-width: 640px;
  }

  /* ---- the chooser ---- */
  .chooser {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s-4);
  }

  .chooser a {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-5);
    background: var(--surface);
    border: var(--hairline);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  .chooser a:hover {
    border-color: var(--green);
    background: var(--hover);
  }

  .ch-ic {
    color: var(--green-ink);
    margin-bottom: var(--s-2);
  }

  .ch-ic :global(svg) {
    width: var(--icon-md);
    height: var(--icon-md);
  }

  .ch-name {
    font-weight: var(--fw-semibold);
  }

  .ch-for {
    font-size: var(--text-sm);
    color: var(--dim);
  }

  /* ---- shared ---- */
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-4);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--s-6);
  }

  h3,
  .sub-head {
    font-size: var(--text-body);
    letter-spacing: 0;
  }

  .sub {
    font-size: var(--text-sm);
    color: var(--dim);
    margin-top: var(--s-1);
  }

  .install {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    align-items: flex-start;
  }

  .install code {
    font-size: var(--text-body);
    padding: var(--s-3) var(--s-4);
    white-space: nowrap;
    max-width: 100%;
    overflow-x: auto;
  }

  .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
