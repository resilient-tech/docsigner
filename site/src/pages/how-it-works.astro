---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import SigningSteps from '../components/SigningSteps.astro';
import { links } from '../config';

/*
 * One question per section: what happens in what order (the stepper), why a
 * helper app has to exist at all (the hop chain), and the two design decisions
 * people ask about.
 *
 * The "which of these am I" cards moved to /download, where choosing a product
 * and getting it happen together.
 */

const hops = [
  {
    name: 'The content script',
    body: 'Runs inside your app’s own world, so it is the only part of the extension your app can reach. It relays messages and does nothing else.',
  },
  {
    name: 'The background worker',
    body: 'The only browser context allowed to open native messaging. It also holds the consent decision and the command allowlist.',
  },
  {
    name: 'The helper app',
    body: 'Separate because a browser cannot load a PKCS#11 driver. It speaks JSON over stdin and stdout, which is all native messaging is.',
  },
];
---

<Layout
  title="How it works"
  description="The four steps of signing a PDF with a USB token from a web page, why your app has to sit between your server and the token, and why a helper app is unavoidable."
>
  <Hero
    kicker="How it works"
    title="The PDF never leaves your server"
    lede="Your app carries a 32-byte hash out and a signature back. The document stays where it is."
  />

  <Section>
    <SigningSteps />
  </Section>

  <Section
    label="The hop chain"
    title="Why a helper app has to exist"
    lede="No browser will let a page open a USB device, so the trip from your app to the token takes three hops."
  >
    <ol class="hops">
      {
        hops.map((h, i) => (
          <li>
            <span class="hop-n">{i + 1}</span>
            <div>
              <h3>{h.name}</h3>
              <p>{h.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="tail">
      At the end of it the token signs 32 bytes and hands them back. It will not
      give up the key, which is why the signing happens in two halves.
    </p>

    <p class="aside">
      Nothing in the chain asks you to trust a localhost certificate, edit
      <code>/etc/hosts</code>, or run Java.
    </p>
  </Section>

  <Section label="Two decisions" title="What we chose, and why">
    <div class="decisions">
      <div>
        <h3>Sessions are files on disk</h3>
        <p>
          Starting a signature writes the pending state and the prepared PDF to a
          directory with a random id and a time limit. Finishing reads it back.
          No database, no Redis. Mount the directory somewhere shared if you run
          more than one server.
        </p>
      </div>
      <div>
        <h3>Consent per origin</h3>
        <p>
          The first time a site asks for your certificates, the extension asks
          you, and it remembers the answer for that origin. There is no key to
          buy and no server of ours to check in with.
        </p>
      </div>
    </div>

    <div class="more">
      <Button
        href={links.docsArchitecture}
        variant="default"
        size="md"
        trailing="lucide:external-link"
      >
        The architecture, in full
      </Button>
      <Button
        href={links.contracts}
        variant="ghost"
        size="md"
        trailing="lucide:external-link"
      >
        Every wire format, frozen
      </Button>
    </div>
  </Section>

  <Section centre>
    <div class="end">
      <h2>This is one of three ways</h2>
      <p class="lede">
        The desktop app and the server flow skip the browser entirely. Same
        signing engine underneath.
      </p>
      <Button href="/download" variant="primary" size="lg">See all three</Button>
    </div>
  </Section>
</Layout>

<style>
  .hops {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-6);
  }

  .hops li {
    display: flex;
    gap: var(--s-3);
  }

  .hop-n {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: var(--pill);
    background: var(--green-soft);
    color: var(--green-ink);
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
  }

  .hops h3,
  .decisions h3 {
    font-size: var(--text-body);
    letter-spacing: 0;
    margin-bottom: var(--s-1);
  }

  .hops p,
  .decisions p {
    font-size: var(--text-sm);
    color: var(--dim);
  }

  .tail {
    margin-top: var(--s-6);
    font-size: var(--text-sm);
    color: var(--dim);
    max-width: var(--measure);
  }

  .aside {
    margin-top: var(--s-8);
    padding-left: var(--s-4);
    border-left: var(--accent-bar) solid var(--green);
    font-size: var(--text-sm);
    color: var(--text);
    max-width: var(--measure);
  }

  .decisions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--s-8);
  }

  .decisions p {
    max-width: 48ch;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }

  /* Centred, and the only centred thing on the page. It carries no label, so it
     is not a section announcing a subject: it is the end of the page, and
     centring is what says so. */
  .end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
  }
</style>
