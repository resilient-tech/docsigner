<?xml version="1.0" encoding="utf-8"?>
<!--
  Sits beside the .exe. Without it the app dies on launch for anyone who
  downloaded the zip:

    RuntimeError: Failed to resolve Python.Runtime.Loader.Initialize from
    ...\_internal\pythonnet\runtime\Python.Runtime.dll

  Windows marks every file extracted from a downloaded archive as coming from the
  internet, and .NET refuses to load a *managed* assembly carrying that mark.
  pywebview's Windows window is WinForms, reached through pythonnet, so the whole
  app stops there. Native DLLs are unaffected, which is why nothing else in the
  bundle complains.

  This switch says "load my own assemblies anyway". Scoped to this executable,
  and no wider than the trust already given by running an unsigned app from a
  folder the user can write to.

  An installer would avoid the mark altogether; until there is one, this is what
  makes a downloaded zip run.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
