# signer-server configuration. Copy to .env and adjust.

# Where in-flight signing sessions and finished documents are stored.
SESSION_DIR=./server/sessions
DOCUMENT_DIR=./server/documents
SESSION_TTL_SECONDS=900
DOCUMENT_TTL_SECONDS=3600

# Server-held key for /api/sign-server-side (optional).
# P12_PATH=/path/to/key.p12
# P12_PASSPHRASE=changeme

# RFC 3161 timestamp authority, required for B-T and above.
# TSA_URL=http://timestamp.digicert.com

# Directory of PEM/DER trust anchor certificates (optional).
# Used for validation and for B-LT/B-LTA revocation embedding.
# TRUST_DIR=/path/to/trust

MAX_PDF_MB=50
