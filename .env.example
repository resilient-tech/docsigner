# signer-server configuration. Copy to .env and adjust.

# Port the reference server listens on (127.0.0.1). Defaults to 8001.
# PORT=8001

# Where in-flight signing sessions and finished documents are stored.
SESSION_DIR=./server/sessions
DOCUMENT_DIR=./server/documents
SESSION_TTL_SECONDS=900
DOCUMENT_TTL_SECONDS=3600

# Server-held key for /api/sign-server-side (optional).
# P12_PATH=/path/to/key.p12
# P12_PASSPHRASE=changeme

# RFC 3161 timestamp authority, required for B-T and above.
# TSA_URL=http://timestamp.digicert.com

# Credentials for a paid TSA, sent only to the TSA_URL above and never to a
# TSA a request picks by name. Every CCA-licensed Indian TSA needs one of these;
# the public authorities in the registry need neither. Pick the scheme your TSA
# documents: TSA_AUTH is HTTP Basic, TSA_BEARER an Authorization bearer token.
# TSA_AUTH=account:password
# TSA_BEARER=eyJhbGciOi...

# Directory of PEM/DER trust anchor certificates (optional).
# Used for validation and required for B-LT/B-LTA revocation embedding,
# which also needs the CA's OCSP/CRL endpoints reachable from here.
# For LTV, include the full chain: root plus issuing intermediates
# (see "Trust anchors for B-LT / B-LTA" in the README).
# TRUST_DIR=/path/to/trust

MAX_PDF_MB=50

# Keep every CRL a chain needs so B-LT/B-LTA/CCA read as LTV enabled in Adobe.
# Some Indian CAs answer end-entity OCSP with a CA-level responder that RFC 6960
# does not authorise for the leaf, so a reader falls back to the sub-CA CRL;
# keeping it makes the signature verify offline, at a larger file size. Set to
# false for OCSP-first sizing (smaller, but the signer may read as not LTV).
# STRICT_LTV=true
