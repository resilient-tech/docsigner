# End-to-end test configuration template. Copy to .env.e2e and fill in secrets.
#   cp e2e/.env.e2e.example e2e/.env.e2e

# Token / DSC PIN used by host and real-DSC e2e tests.
OPENSIGNER_PIN=changeme

# Signer identity the test certs and signatures carry (PII).
E2E_SIGNER_CN=Test Signer
E2E_SIGNER_ORG=OpenSigner Tests
E2E_SIGNER_COUNTRY=IN
E2E_SIGNER_EMAIL=test@example.org
E2E_SIGN_REASON=E2E test signature
E2E_SIGN_LOCATION=Test City, IN

# Passphrase for the server-held .p12 (server-side / XAdES flows).
E2E_P12_PASSPHRASE=changeme

# Live endpoints the harness boots.
E2E_SERVER_PORT=8899
E2E_DEMO_PORT=8898

# Trust anchors + timestamp authority.
E2E_TRUST_DIR=./trust
TSA_URL=http://timestamp.digicert.com

# Real-token / browser gates (off by default).
OPENSIGNER_E2E_REAL_TOKEN=0
# OPENSIGNER_PKCS11_MODULES=/path/to/your/pkcs11.so
OPENSIGNER_E2E_BROWSER=0
